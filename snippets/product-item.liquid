{%- comment -%} Snippet para grade de coleção (sem schema) {%- endcomment -%}
<div class="site-container pt-6 lg:pt-10 pb-24">
  <div class="pb-10">
    <div class="d-grid lg:grid-cols-2 items-center gap-6 lg:gap-2">
      <div class="order-2 lg:order-1 d-grid gap-4 lg:pl-24">
        <h1 class="eyebrow">{{ collection.title }}</h1>
      </div>
      <div class="order-1 lg:order-2">
        <div class="aspect-[2.2] relative bg-beige"></div>
      </div>
    </div>
  </div>

  {% if collection.products_count > 0 %}
    <div class="d-grid gap-4 md:grid-cols-2 md:gap-2 lg:grid-cols-4 pt-4 lg:pt-10 items-start">
      {% for product in collection.products %}
        {% render 'product-item', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <p class="pt-8 text-center opacity-75">Nenhum produto nesta coleção.</p>
  {% endif %}
</div>
