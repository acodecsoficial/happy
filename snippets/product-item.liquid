{% unless show_atc == false %}
  {% assign show_atc = true %}
{% endunless %}

{% unless show_learn_more == false %}
  {% assign show_learn_more = true %}
{% endunless %}

<div class="product-card-wrapper flex flex-col h-full gap-4 mb-4 lg:mb-6{% if fix_atc %} is-sticky-atc{% endif %}">
  <!-- BLOCO SUPERIOR: imagem + textos ocupam a altura disponível -->
  <div class="flex-1 flex flex-col">
    <!-- Imagem (linka para o produto) -->
    <a href="{{ product.url }}" class="block">
      <div class="aspect-[7/8] relative bg-beige">
        <img
          width="500" height="500"
          src="{{ product.images[0].src | image_url: width: 500 }}"
          class="absolute top-0 left-0 w-full h-full object-cover object-center"
          alt="{{ product.title | escape }}"
        >
        {% unless product.images[1] == blank %}
          <img
            width="500" height="500"
            src="{{ product.images[1].src | image_url: width: 500 }}"
            class="absolute top-0 left-0 w-full h-full object-cover object-center opacity-0 transition-opacity duration-300 lg:hover:opacity-100 z-10"
            alt="{{ product.title | escape }}"
          >
        {% endunless %}
      </div>
    </a>

    <!-- Textos (crescem para equalizar a altura dos cards) -->
    <div class="d-grid gap-2 px-2 lg:px-3 flex-1">
      {% assign italic_metafield = product.metafields['happy-aging'].italicized_product_title_segment | downcase %}
      {% if italic_metafield %}
        {% assign italic = '<em class="font-heading-light-italic">' | append: italic_metafield | append: '</em>' %}
        {% assign final_product_title = product.title | downcase | replace: italic_metafield, italic %}
      {% else %}
        {% assign final_product_title = product.title %}
      {% endif %}

      <h2 class="heading !text-[40px] lowercase truncate">
        {{ final_product_title }}
      </h2>
      <p class="eyebrow truncate">{{ product.metafields.custom.eyebrow }}</p>
      <p class="eyebrow">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</p>
    </div>
  </div>

  <!-- BLOCO INFERIOR: ações (sempre no rodapé graças ao mt-auto) -->
  {% if show_atc == true %}
    <div class="mt-auto w-full">
      {% assign product_form_id = 'quick-add-' | append: section_id | append: product.id %}

      <!-- Form padrão (evita página em branco / depende menos de JS do tema) -->
      <form method="post" action="{{ routes.cart_add_url }}" id="{{ product_form_id }}" class="form">
        <input
          type="hidden" name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
        >
        <input type="hidden" name="properties[_ts]" value="{{ 'now' | date: '%s%L' }}">
        <input type="hidden" name="return_to" value="back">

        <button
          id="{{ product_form_id }}-submit"
          type="submit" name="add"
          class="quick-add__submit button button--black button--full-width{% if horizontal_quick_add %} card--horizontal__quick-add{% endif %}"
          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
        >
          <span>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
          {%- if horizontal_quick_add -%}
            <span class="icon-wrap">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
          {%- endif -%}
        </button>
      </form>

      {% if show_learn_more == true %}
        <a href="{{ product.url }}" class="mt-2 button button--cream button--full-width">Learn More</a>
      {% endif %}
    </div>
  {% endif %}
</div>
