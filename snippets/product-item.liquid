{%- assign p = product -%}

<div class="product-card">
  <!-- Imagem e link principal -->
  <a href="{{ p.url }}" class="product-card__media" aria-label="{{ p.title }}">
    {%- if p.featured_image -%}
      {{ p.featured_image | image_url: width: 800 | image_tag: alt: p.title, loading: 'lazy' }}
    {%- endif -%}
  </a>

  <!-- Informações do produto -->
  <div class="product-card__info">
    <!-- Título -->
    <h3 class="product-card__title">
      <a href="{{ p.url }}">{{ p.title }}</a>
    </h3>

    <!-- Preço -->
    {%- if p.price -%}
      <div class="product-card__price">
        {%- if p.compare_at_price > p.price -%}
          <span class="price price--sale">{{ p.price | money }}</span>
          <s class="price price--compare">{{ p.compare_at_price | money }}</s>
        {%- else -%}
          <span class="price">{{ p.price | money }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Botão Add To Cart -->
    {%- if show_atc -%}
      <form method="post" action="/cart/add" class="product-card__atc">
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        <button type="submit" class="btn btn--primary" {% unless p.available %}disabled{% endunless %}>
          Add To Cart
        </button>
      </form>
    {%- endif -%}

    <!-- Botão Learn More (controlado pelo checkbox) -->
    {%- if show_learn_more -%}
      <a href="{{ p.url }}" class="btn btn--secondary learn-more-btn">Learn More</a>
    {%- endif -%}
  </div>
</div>
