                              class="rebuy-product-title"
                              v-bind:href="learnMoreURL(product)"
                              v-on:click="learnMore(product, $event);"
                              v-html="product.title"
                              v-bind:class="[hasLearnMore() ? 'clickable' : '']"
                              v-bind:aria-label="'View ' + product.title"
                              rel="nofollow"
