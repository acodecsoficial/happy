<p>Posição escolhida: {{ block.settings.image_position }}</p>

<section id="focus-you" class="focus-you-section">
  <div class="focus-you__inner">
    {% if section.settings.title != blank %}
      <h2 class="focus-you__title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="focus-you__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% for block in section.blocks %}
      {%- assign pos = block.settings.image_position | default: 'right' -%}
      <div class="focus-you__row focus-you__row--image-{{ pos }}">
        <div class="focus-you__media">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | img_url: 'master' }}"
                 alt=""
                 class="focus-you__img">
          {% endif %}
        </div>
        <div class="focus-you__content">
          {% if block.settings.heading_1 != blank %}
            <h3 class="focus-you__heading">{{ block.settings.heading_1 }}</h3>
          {% endif %}
          {% if block.settings.text_1 != blank %}
            <div class="focus-you__text">{{ block.settings.text_1 }}</div>
          {% endif %}

          {% if block.settings.heading_2 != blank %}
            <h3 class="focus-you__heading">{{ block.settings.heading_2 }}</h3>
          {% endif %}
          {% if block.settings.text_2 != blank %}
            <div class="focus-you__text">{{ block.settings.text_2 }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  /* === Focus You Section === */
.focus-you-section {
  padding: 4rem 0;
  background-color: #fff;
}

.focus-you__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1rem;
}

.focus-you__title {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem;
  text-align: center;
  margin-bottom: 1rem;
}

.focus-you__subtitle {
  font-family: 'Open Sans', sans-serif;
  font-size: 1.125rem;
  text-align: center;
  margin-bottom: 3rem;
  color: #555;
}

/* Cada “linha” (row) com imagem + texto */
.focus-you__row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  align-items: center;
  gap: 2rem;
  margin-bottom: 4rem;
}

/* Inverte a ordem quando a imagem for à esquerda */
.focus-you__row--image-left .focus-you__media {
  order: -1;
}

.focus-you__media img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 0.5rem;
}

.focus-you__content {
  /* caso queira centrar verticalmente algum texto extra, use flex */
}

.focus-you__heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}

.focus-you__text {
  font-family: 'Open Sans', sans-serif;
  font-size: 0.9375rem;
  line-height: 1.6;
  margin-bottom: 1.5rem;
  color: #333;
}

/* Responsivo para mobile */
@media (max-width: 767px) {
  .focus-you__row {
    grid-template-columns: 1fr;
  }
  .focus-you__media {
    margin-bottom: 1.5rem;
  }
}

</style>
{% schema %}
{
  "name": "Focus You",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da seção",
      "default": "FOCUS YOU can feel"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo (opcional)"
      /* removido default vazio */
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Linha de conteúdo",
      "settings": [
        {
          "type": "select",
          "id": "image_position",
          "label": "Posição da imagem",
          "options": [
            { "value": "right", "label": "Direita" },
            { "value": "left",  "label": "Esquerda" }
          ],
          "default": "right"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "heading_1",
          "label": "Título 1",
          "default": "Get centered, stay clear"
        },
        {
          "type": "richtext",
          "id": "text_1",
          "label": "Texto 1",
          "default": "<p>Magnesium bisglycinate helps balance neurotransmitters so your brain can shift into a more centered, steady state. Without sedation.</p>"
        },
        {
          "type": "text",
          "id": "heading_2",
          "label": "Título 2",
          "default": "Stay laser-focused"
        },
        {
          "type": "richtext",
          "id": "text_2",
          "label": "Texto 2",
          "default": "<p>Supports cognitive performance under pressure. Keep your thinking clear and responsive, no matter the mental load.</p>"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Focus You",
      "category": "Custom"
    }
  ]
}
{% endschema %}

