{% assign italic_metafield = product.metafields['happy-aging'].italicized_product_title_segment %}
{% if italic_metafield %}
  {% assign italic = '<em class="font-heading-light-italic">' | append: italic_metafield | append: '</em>' %}
  {% assign final_product_title = product.title | replace_first: italic_metafield, italic | replace: 'Shot', 'shot' | replace: 'Test', 'test' %}
{% else %}
  {% assign final_product_title = product.title %}
{% endif %}
{% assign custom_list_rendered = false %}
{% assign aside_content_rendered = false %}

<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
  {%- if section.settings.gallery_layout == 'thumbnail_slider' -%}
    data-swiper-gallery="true"
  {%- endif -%}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    #shopify-section-{{ section.id }} {
      --highlight-color: {{ section.settings.highlight_color }}
    }
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  <div class="site-container min-h-screen flex flex-col lg:flex-row bg-[#f7f4ea] px-4 min-[1440px] lg:gap-16 xl:gap-20 padding_mobile padding-right0 margin-right0">
  <!-- Coluna Esquerda: Conteúdo -->
  <div class="flex-1 flex flex-col justify-center xl:px-20 order-2 lg:order-1 max-w-xl w-full py-8 mx-auto lg:mx-0 padding_2">
    <span class="uppercase tracking-[1px] text-[10px] xl:text-[12px] text-black mb-1 eyebrow">{{ product.metafields.custom.eyebrow }}</span>

    
    <div class="flex justify-between ">
      <h1 class="text-5xl md:text-6xl font-black leading-tight mb-4 heading heading--1 font-50 max-306">
     {{ section.settings.title }}
    </h1>
      <img src="https://cdn.shopify.com/s/files/1/0869/3704/3264/files/image_3.png?v=1751638637" style="width: 102px;height: 102px;">
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'offer_details' %}
        <div class="mt-6 pb-5">
          <div class="flex items-center justify-between">
            <span class="text-base font-geral font-28">{{ block.settings.title }}</span>
            
          </div>
          <div class="mt-3 font-12 font-surt">
            + PLUS ONE FREE GLOW SHOT
          </div>

        <div class="subscribe mt-6">
          <div class="flex justify-between">
            <h2 class="subscribe_title font-surt">SUBSCRIBE & SAVE</h2>
            <div class="text-[20px] lg:text-[22px] grid grid-flow-col gap-2" style="align-items: center;">
              <span class="text-[#9E9B9B] line-through heading" style="font-size: 25px">$60</span>
              <span class="text-[#1E1E1E] font-bold heading">$30</span>
            </div>
          </div>
        </div>
          <div class="mt-3 flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <img src="https://cdn.shopify.com/s/files/1/0869/3704/3264/files/check.svg?v=1751644101">
              <p class="text-[12px] font-surt" style="color: #707070">{{ block.settings.cadence }}</p>
            </div>
            <div class="flex items-center gap-2">
              <img src="https://cdn.shopify.com/s/files/1/0869/3704/3264/files/check.svg?v=1751644101">
              <p class="text-[12px] font-surt" style="color: #707070">{{ block.settings.shipping_time }}</p>
            </div>
          </div>
        </div>

        
      {% endif %}

      {% if block.type == 'monthly_gifts' %}
        <div class="border-b border-black pb-6" style="display: none;">
          <span class="text-base block mb-2 md:mb-4">{{ block.settings.title }}</span>
          <div class="grid md:gap-4">
            <!-- Mantém seus gifts, só classes ajustadas! -->
            <div class="flex items-center gap-3 border-b border-beige pb-2 mb-2">
              <div class="py-1 px-3 bg-beige text-[11px] uppercase font-semibold tracking-[1px] text-center">Every month</div>
              <span class="text-[12px] eyebrow tracking-[1px]">{{ block.settings.every_month_gift }}</span>
              <span class="text-[#9E9B9B] line-through text-[13px]">{{ block.settings.every_month_value }}</span>
              <span class="text-[#D0535B] text-[14px] font-bold">$0</span>
            </div>
            <div class="flex items-center gap-3 border-b border-beige pb-2 mb-2">
              <div class="py-1 px-3 bg-beige text-[11px] uppercase font-semibold tracking-[1px] text-center">Month Two</div>
              <span class="text-[12px] eyebrow tracking-[1px]">{{ block.settings.month_two_gift }}</span>
              <span class="text-[#9E9B9B] line-through text-[13px]">{{ block.settings.month_two_value }}</span>
              <span class="text-[#D0535B] text-[14px] font-bold">$0</span>
            </div>
            <div class="flex items-center gap-3 border-b border-beige pb-2 mb-2">
              <div class="py-1 px-3 bg-beige text-[11px] uppercase font-semibold tracking-[1px] text-center">Month Three</div>
              <span class="text-[12px] eyebrow tracking-[1px]">{{ block.settings.month_three_gift }}</span>
              <span class="text-[#9E9B9B] line-through text-[13px]">{{ block.settings.month_three_value }}</span>
              <span class="text-[#D0535B] text-[14px] font-bold">$0</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="py-1 px-3 bg-beige text-[11px] uppercase font-semibold tracking-[1px] text-center">Month Four</div>
              <span class="text-[12px] eyebrow tracking-[1px]">{{ block.settings.month_four_gift }}</span>
              <span class="text-[#9E9B9B] line-through text-[13px]">{{ block.settings.month_four_value }}</span>
              <span class="text-[#D0535B] text-[14px] font-bold">$0</span>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}

    <div class="pt-4">
      <div class="flex items-center justify-between">
        <span class="text-base border-bottom block heading" style="width: 80%;">Your First Month Total</span>
        <div class="text-[20px] lg:text-[22px] grid grid-flow-col gap-2">
            <span class="text-[#1E1E1E] heading">$30</span>
          </div>
      </div>
      <p class="text-xs mt-1.5 font-surt" style="color: #707070">$60/mo every 5 weeks after</p>
    </div>

    <cart-add>
      <form class="mt-6 lg:mt-10 justify-center flex">
        <input type="hidden" name="id" id="variant-id-js" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="selling_plan" value="{{ product.selling_plan_groups[0].selling_plans[0].id }}">
        <button class="mb-5 lg:mb-1 button button--black border border-black">
          <div class="flex flex-col items-center pb-1.5">
            <span class="text-[20px] lg:text-[32px] font-body-regular heading" style="padding-top: 10px;">Try It Today</span>
           
          </div>
        </button>
      </form>
    </cart-add>

    <div class="mt-4 lg:mt-6 text-center flex flex-col items-center">
      <p class="text-[12px] font-surt" style="color: #707070; font-weight: 400;">{{ section.settings.sub_cta_text }}</p>
      <p class="text-[12px] max-w-[450px] mx-auto font-surt" style="color: #707070; font-weight: 400;">{{ section.settings.sub_cta_description }}</p>
    </div>
  </div>
  <!-- Coluna Direita: Imagem -->
  <div class="flex-1 flex items-center justify-center order-1 lg:order-2">
    <div class="aspect-[0.93] w-full h-full relative">
      {% unless product.images[0] == blank %}
        <img class="top-0 left-0 w-full h-full object-cover object-center rounded-2xl shadow-lg" src="{{ product.images[0] | img_url: '1000x' }}" loading="lazy" />
      {% endunless %}
    </div>
  </div>
</div>

<style>
  .padding-right0{
    padding-right: 0 !important;
  }

  .margin-right0{
    margin-right: 0 !important;
  }
</style>

  

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
  "type": "offer_details",
  "name": "Offer Details",
  "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "cadence", "label": "Cadence" },
    { "type": "text", "id": "shipping_time", "label": "Shipping Time" }
  ]
},
{
  "type": "monthly_gifts",
  "name": "Monthly Gifts",
  "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "every_month_gift", "label": "Every Month Gift" },
    { "type": "text", "id": "every_month_value", "label": "Every Month Value" },
    { "type": "text", "id": "month_two_gift", "label": "Month 2 Gift" },
    { "type": "text", "id": "month_two_value", "label": "Month 2 Value" },
    { "type": "text", "id": "month_three_gift", "label": "Month 3 Gift" },
    { "type": "text", "id": "month_three_value", "label": "Month 3 Value" },
    { "type": "text", "id": "month_four_gift", "label": "Month 4 Gift" },
    { "type": "text", "id": "month_four_value", "label": "Month 4 Value" }
  ]
},

    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "t:sections.main-product.blocks.text.settings.text.default",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        },
        {
          "type": "text",
          "id": "customclass",
          "default": "yourcustomclass",
          "label": "Custom class"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "Body"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "bold",
              "label": "Bold"
            }
          ],
          "default": "body",
          "label": "Text style"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "text-[10px]",
              "label": "Tiny"
            },
            {
              "value": "text-xs",
              "label": "Extra Small"
            },
            {
              "value": "text-sm",
              "label": "Small"
            },
            {
              "value": "text-base",
              "label": "Regular"
            },
            {
              "value": "text-lg",
              "label": "Large"
            }
          ],
          "default": "text-base",
          "label": "Text size"
        },
        {
          "type": "select",
          "id": "text_align",
          "options": [
            {
              "value": "text-left",
              "label": "Left"
            },
            {
              "value": "text-center",
              "label": "Center"
            },
            {
              "value": "text-right",
              "label": "Right"
            }
          ],
          "default": "text-left",
          "label": "Text align"
        },
        
      ]
    },
    {
      "type": "ingredients_block",
      "name": "Ingredients Blocks",
      "settings": [
        {
          "type": "richtext",
          "id": "text1",
          "label": "Title 1"
        },
        {
          "type": "richtext",
          "id": "text2",
          "label": "Content 2"
        },
        {
          "type": "richtext",
          "id": "text3",
          "label": "Title 3"
        },
        {
          "type": "richtext",
          "id": "text4",
          "label": "Content 4"
        },
        {
          "type": "richtext",
          "id": "text5",
          "label": "Title 5"
        },
        {
          "type": "richtext",
          "id": "text6",
          "label": "Content 6"
        },
      ] 
    },
    {
      "type": "title",
      "name": "t:sections.main-product.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text"
        },
      ]
    },
    {
      "type": "quantity_block",
      "name": "Quantity block",
      "settings": [
        {
          "type": "image_picker",
