{% comment %}
  Breakthrough Section
  Two-column layout: heading/subheading on left, dynamic feature list on right.
{% endcomment %}

<section class="breakthrough-section" id="{{ section.id }}">
  <div class="breakthrough-section__inner">
    <div class="breakthrough-section__content">
      <h2 class="breakthrough-section__title heading">{{ section.settings.heading }}</h2>
      <p class="breakthrough-section__subtitle heading">{{ section.settings.subheading }}</p>
    </div>
    <div class="breakthrough-section__features">
      {% for block in section.blocks %}
        <div class="breakthrough-feature">
          <h3 class="breakthrough-feature__heading heading">{{ block.settings.title }}</h3>
          <p class="breakthrough-feature__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  li::marker{
    margin: 10px !important;
    padding: 10px;
  }
  .breakthrough-section{
    border-top: 1px solid #000;
    padding: 60px 0px;
  }

  .breakthrough-section__title{
    font-size: 50px;
    margin-bottom: 10px;
  }

  .breakthrough-section__subtitle{
    font-size: 24px;
    font-style: italic;
  }
.breakthrough-section__inner {
  max-width: 1310px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  gap: 100px;
}
.breakthrough-section__content {
  flex: 1 1 40%;
  max-width: 448px;
}
.breakthrough-section__features {
  flex: 1 1 50%;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(281px, 1fr));
  gap: 63px;
}
.breakthrough-feature__heading {
  margin-bottom: 0.5rem;
  font-size: 40px;
}
.breakthrough-feature__text {
  margin: 0;
  font-size: 16px;
  max-width: 226px;
}

  .breakthrough-feature__heading::before {
  content: "•";
  margin-right: 10px;
  font-size: 1em;
}
@media (max-width: 768px) {
  .breakthrough-section__inner {
    flex-direction: column;
  }
}
</style>

{% schema %}
{
  "name": "Breakthrough Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "The breakthrough that changes everything"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Why most sleep aids fail: They force sedation instead of supporting natural sleep processes. Result? You're unconscious but not restored."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "GABA"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Text",
          "default": "Shuts down the mental chatter and anxiety that keeps you awake."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Breakthrough Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
