{{ 'section-rs-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign layout_class = ''
  case section.settings.layout_type
    when 'full_width'
      assign layout_class = 'rs-hero--full-width'
    when 'split_50_50'
      assign layout_class = 'rs-hero--split'
    when 'three_column'
      assign layout_class = 'rs-hero--three-column'
    when 'split_image'
      assign layout_class = 'rs-hero--split-image'
    when 'split_video_image'
      assign layout_class = 'rs-hero--split-video-image'
  endcase

  assign content_position_classes = ''
  case section.settings.content_position
    when 'left-top'
      assign content_position_classes = 'items-start justify-start'
    when 'left-center'
      assign content_position_classes = 'items-center justify-start'
    when 'left-bottom'
      assign content_position_classes = 'items-end justify-start'
    when 'center-top'
      assign content_position_classes = 'items-start justify-center'
    when 'center-center'
      assign content_position_classes = 'items-center justify-center'
    when 'center-bottom'
      assign content_position_classes = 'items-end justify-center'
    when 'right-top'
      assign content_position_classes = 'items-start justify-end'
    when 'right-center'
      assign content_position_classes = 'items-center justify-end'
    when 'right-bottom'
      assign content_position_classes = 'items-end justify-end'
  endcase
-%}

<style>
  #rs-hero-{{ section.id }} {
    --rs-hero-bg-color: {{ section.settings.background_color | default: 'transparent' }};
    --rs-hero-mobile-bg-color: {{ section.settings.mobile_background_color | default: 'rgba(0, 0, 0, 0.7)' }};
    --rs-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --rs-hero-min-height: {{ section.settings.section_height }}px;
    --rs-hero-min-height-mobile: {{ section.settings.section_height_mobile }}px;
    --rs-hero-text-position: {{ section.settings.text_position }};
    --rs-hero-text-position-mobile: {{ section.settings.text_position_mobile }};
    --rs-hero-overlay-text-bg: {{ section.settings.overlay_text_bg_color | default: 'rgba(0, 0, 0, 0.7)' }};
  }

  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'subtitle' %}
        #rs-hero-{{ section.id }} .rs-hero__subtitle--{{ block.id }} {
          color: {{ block.settings.subtitle_color }};
          font-size: {{ block.settings.subtitle_size_desktop }}px;
        }
        @media screen and (max-width: 749px) {
          #rs-hero-{{ section.id }} .rs-hero__subtitle--{{ block.id }} {
            font-size: {{ block.settings.subtitle_size_mobile }}px;
          }
        }

      {% when 'title' %}
        #rs-hero-{{ section.id }} .rs-hero__title--{{ block.id }} {
          color: {{ block.settings.title_color }};
          font-size: {{ block.settings.title_size_desktop }}px;
          line-height: {{ block.settings.title_line_height_desktop }};
        }
        @media screen and (max-width: 749px) {
          #rs-hero-{{ section.id }} .rs-hero__title--{{ block.id }} {
            font-size: {{ block.settings.title_size_mobile }}px;
            line-height: {{ block.settings.title_line_height_mobile }};
          }
        }

      {% when 'description' %}
        #rs-hero-{{ section.id }} .rs-hero__description--{{ block.id }} {
          color: {{ block.settings.description_color }};
          font-size: {{ block.settings.description_size_desktop }}px;
        }
        @media screen and (max-width: 749px) {
          #rs-hero-{{ section.id }} .rs-hero__description--{{ block.id }} {
            font-size: {{ block.settings.description_size_mobile }}px;
          }
        }

      {% when 'cta_button' %}
        #rs-hero-{{ section.id }} .rs-hero__cta--{{ block.id }} {
          background-color: {{ block.settings.button_bg_color }};
          color: {{ block.settings.button_text_color }};
          border: 1px solid {{ block.settings.button_border_color | default: block.settings.button_bg_color }};
          padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
          border-radius: {{ block.settings.button_border_radius }}px;
          font-size: {{ block.settings.button_text_size }}px;
          transition: all 0.3s ease;
          margin-top: {{ block.settings.button_margin_top }}px;
          margin-bottom: {{ block.settings.button_margin_bottom }}px;
        }
        #rs-hero-{{ section.id }} .rs-hero__cta--{{ block.id }}:hover {
          background-color: {{ block.settings.button_hover_bg_color }};
          color: {{ block.settings.button_hover_text_color }};
          border-color: {{ block.settings.button_hover_border_color | default: block.settings.button_hover_bg_color }};
        }
    {% endcase %}
  {% endfor %}
</style>

<section
  id="rs-hero-{{ section.id }}"
  class="rs-hero {{ layout_class }} {{ section.settings.css_class }} {% if section.settings.text_position == 'left' %}text-left{% elsif section.settings.text_position == 'right' %}text-right{% else %}text-center{% endif %} {% if section.settings.text_position_mobile == 'left' %}mobile-text-left{% elsif section.settings.text_position_mobile == 'right' %}mobile-text-right{% else %}mobile-text-center{% endif %}"
  style="background-color: var(--rs-hero-bg-color);"
  data-mobile-position="{{ section.settings.mobile_content_position | default: 'overlay' }}"
  {% if section.settings.section_id != blank %}data-section-id="{{ section.settings.section_id }}"{% endif %}
>
  {%- comment -%} Background Media {%- endcomment -%}
  {% if section.settings.background_image_desktop != blank or section.settings.background_video_desktop != blank %}
    <div class="rs-hero__background">
      {%- comment -%} Desktop Background {%- endcomment -%}
      {% if section.settings.background_video_desktop != blank %}
        <div class="rs-hero__bg-video rs-hero__bg-video--desktop">
          <site-video>
            <video
              class="w-full h-full object-cover"
              {% if section.settings.background_video_poster != blank %} poster="{{ section.settings.background_video_poster | image_url: width: 1920 }}"{% endif %}
              autoplay
              muted
              loop
              playsinline
            >
              <source src="{{ section.settings.background_video_desktop }}" type="video/mp4">
            </video>
          </site-video>
        </div>
      {% elsif section.settings.background_image_desktop != blank %}
        <div class="rs-hero__bg-image rs-hero__bg-image--desktop">
          {{
            section.settings.background_image_desktop
            | image_url: width: 3840
            | image_tag:
              class: 'w-full h-full object-cover',
              sizes: '100vw',
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
              fetchpriority: fetch_priority
          }}
        </div>
      {% endif %}

      {%- comment -%} Mobile Background {%- endcomment -%}
      {% liquid
        assign mobile_video = section.settings.background_video_mobile
        assign mobile_image = section.settings.background_image_mobile
        
        # Video fallback logic
        if mobile_video == blank and section.settings.background_video_desktop != blank
          assign mobile_video = section.settings.background_video_desktop
        endif
        
        # Image fallback logic
        if mobile_image == blank
          assign mobile_image = section.settings.background_image_desktop
        endif
      %}
      
      {% if mobile_video != blank %}
        <div class="rs-hero__bg-video rs-hero__bg-video--mobile">
          <site-video>
            <video
              class="w-full h-full object-cover"
              {% if section.settings.background_video_poster != blank %} poster="{{ section.settings.background_video_poster | image_url: width: 1920 }}"{% endif %}
              autoplay
              muted
              loop
              playsinline
            >
              <source src="{{ mobile_video }}" type="video/mp4">
            </video>
          </site-video>
        </div>
      {% elsif mobile_image != blank %}
        <div class="rs-hero__bg-image rs-hero__bg-image--mobile">
          {{
            mobile_image
            | image_url: width: 1500
            | image_tag:
              class: 'w-full h-full object-cover',
              sizes: '100vw',
              widths: '375, 550, 750, 1100, 1500',
              fetchpriority: fetch_priority
          }}
        </div>
      {% endif %}

      {% if section.settings.overlay_opacity > 0 %}
        <div class="rs-hero__overlay"></div>
      {% endif %}
    </div>
  {% endif %}

  <div class="rs-hero__container">
    {%- case section.settings.layout_type -%}
      {%- when 'full_width' -%}
        <div class="rs-hero__content rs-hero__content--overlay flex {{ content_position_classes }}">
          <div class="rs-hero__content-inner">
            {% render 'rs-hero-blocks', blocks: section.blocks %}
          </div>
        </div>

      {%- when 'split_50_50' -%}
        <div class="rs-hero__split-container {% if section.settings.split_layout_order == 'media_left' %}rs-hero__split-container--media-left{% endif %}">
          {% if section.settings.split_layout_order == 'media_left' %}
            <div class="rs-hero__split-media">
              {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media' %}
            </div>
            <div class="rs-hero__split-content">
              <div class="rs-hero__content-inner">
                {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
              </div>
            </div>
          {% else %}
            <div class="rs-hero__split-content">
              <div class="rs-hero__content-inner">
                {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
              </div>
            </div>
            <div class="rs-hero__split-media">
              {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media' %}
            </div>
          {% endif %}
        </div>

      {%- when 'three_column' -%}
        <div class="rs-hero__three-col-container">
          <div class="rs-hero__three-col-left">
            {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media', media_type: 'video' %}
          </div>
          <div class="rs-hero__three-col-center">
            {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media', media_type: 'image' %}
          </div>
          <div class="rs-hero__three-col-right">
            <div class="rs-hero__content-inner">
              {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
            </div>
          </div>
        </div>

      {%- when 'split_image' -%}
        <div class="rs-hero__split-image-container {% if section.settings.split_media_order == 'reverse' %}rs-hero__split-image-container--reverse{% endif %}">
          <div class="rs-hero__split-media-column rs-hero__split-media-column--first">
            <div class="rs-hero__media-wrapper">
              {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media', media_type: 'image', media_index: 1 %}
              {% if section.settings.overlay_text_position != 'none' and section.settings.overlay_text_column == 'left' %}
                <div class="rs-hero__overlay-text rs-hero__overlay-text--{{ section.settings.overlay_text_position }}">
                  <div class="rs-hero__content-inner">
                    {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
          <div class="rs-hero__split-media-column rs-hero__split-media-column--second">
            <div class="rs-hero__media-wrapper">
              {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media', media_type: 'image', media_index: 2 %}
              {% if section.settings.overlay_text_position != 'none' and section.settings.overlay_text_column == 'right' %}
                <div class="rs-hero__overlay-text rs-hero__overlay-text--{{ section.settings.overlay_text_position }}">
                  <div class="rs-hero__content-inner">
                    {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
          {% if section.settings.overlay_text_position != 'none' and section.settings.overlay_text_column == 'center' %}
            <div class="rs-hero__overlay-text rs-hero__overlay-text--center rs-hero__overlay-text--{{ section.settings.overlay_text_position }}">
              <div class="rs-hero__content-inner">
                {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
              </div>
            </div>
          {% endif %}
        </div>

      {%- when 'split_video_image' -%}
        <div class="rs-hero__split-video-image-container {% if section.settings.split_media_order == 'reverse' %}rs-hero__split-video-image-container--reverse{% endif %}">
          <div class="rs-hero__split-media-column rs-hero__split-media-column--video">
            <div class="rs-hero__media-wrapper">
              {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media', media_type: 'video' %}
              {% if section.settings.overlay_text_position != 'none' and section.settings.overlay_text_column == 'left' %}
                <div class="rs-hero__overlay-text rs-hero__overlay-text--{{ section.settings.overlay_text_position }}">
                  <div class="rs-hero__content-inner">
                    {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
          <div class="rs-hero__split-media-column rs-hero__split-media-column--image">
            <div class="rs-hero__media-wrapper">
              {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'media', media_type: 'image' %}
              {% if section.settings.overlay_text_position != 'none' and section.settings.overlay_text_column == 'right' %}
                <div class="rs-hero__overlay-text rs-hero__overlay-text--{{ section.settings.overlay_text_position }}">
                  <div class="rs-hero__content-inner">
                    {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
          {% if section.settings.overlay_text_position != 'none' and section.settings.overlay_text_column == 'center' %}
            <div class="rs-hero__overlay-text rs-hero__overlay-text--center rs-hero__overlay-text--{{ section.settings.overlay_text_position }}">
              <div class="rs-hero__content-inner">
                {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
              </div>
            </div>
          {% endif %}
        </div>
    {%- endcase -%}
  </div>

  {%- comment -%} Mobile Content Background {%- endcomment -%}
  {% if section.settings.mobile_content_position == 'below' %}
    <div class="rs-hero__mobile-content-bg">
      <div class="rs-hero__content-inner">
        {% render 'rs-hero-blocks', blocks: section.blocks, block_types: 'text' %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "RS Hero Section",
  "tag": "section",
  "class": "section rs-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Type",
      "default": "full_width",
      "options": [
        {
          "value": "full_width",
          "label": "Full Width with Overlay"
        },
        {
          "value": "split_50_50",
          "label": "Split 50/50"
        },
        {
          "value": "three_column",
          "label": "Three Column"
        },
        {
          "value": "split_image",
          "label": "Split Image (Image + Image)"
        },
        {
          "value": "split_video_image",
          "label": "Split Video + Image"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position (Full Width Only)",
      "default": "center-center",
      "options": [
        { "value": "left-top", "label": "Left Top" },
        { "value": "left-center", "label": "Left Center" },
        { "value": "left-bottom", "label": "Left Bottom" },
        { "value": "center-top", "label": "Center Top" },
        { "value": "center-center", "label": "Center Center" },
        { "value": "center-bottom", "label": "Center Bottom" },
        { "value": "right-top", "label": "Right Top" },
        { "value": "right-center", "label": "Right Center" },
        { "value": "right-bottom", "label": "Right Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "text_position_mobile",
      "label": "Text Position Mobile",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Background & Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile Content Background Color",
      "default": "#ffffff",
      "info": "Background color for text on mobile when media is present"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Background Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background Image Mobile"
    },
    {
      "type": "text",
      "id": "background_video_desktop",
      "label": "Background Video Desktop (.mp4)",
      "info": "Video will override background image on desktop"
    },
    {
      "type": "text",
      "id": "background_video_mobile",
      "label": "Background Video Mobile (.mp4)",
      "info": "Video will override background image on mobile"
    },
    {
      "type": "image_picker",
      "id": "background_video_poster",
      "label": "Background Video Poster Image",
      "info": "Fallback image shown while video loads"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section Dimensions"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Section Height Desktop",
      "default": 600
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Section Height Mobile",
      "default": 400
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Mobile Content Position",
      "default": "overlay",
      "options": [
        {
          "value": "overlay",
          "label": "Overlay on Media"
        },
        {
          "value": "below",
          "label": "Below Media"
        }
      ],
      "info": "Choose whether content appears over the media or below it on mobile devices"
    },
    {
      "type": "select",
      "id": "split_layout_order",
      "label": "Split Layout Order",
      "default": "text_left",
      "options": [
        {
          "value": "text_left",
          "label": "Text Left, Media Right"
        },
        {
          "value": "media_left",
          "label": "Media Left, Text Right"
        }
      ],
      "info": "Only applies to Split 50/50 layout"
    },
    {
      "type": "select",
      "id": "split_media_order",
      "label": "Split Media Order",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Normal Order"
        },
        {
          "value": "reverse",
          "label": "Reverse Order"
        }
      ],
      "info": "Only applies to Split Image and Split Video+Image layouts"
    },
    {
      "type": "select",
      "id": "overlay_text_position",
      "label": "Overlay Text Position",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "No Overlay Text"
        },
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-center",
          "label": "Top Center"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        },
        {
          "value": "center-left",
          "label": "Center Left"
        },
        {
          "value": "center-center",
          "label": "Center Center"
        },
        {
          "value": "center-right",
          "label": "Center Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "info": "Only applies to Split Image and Split Video+Image layouts"
    },
    {
      "type": "select",
      "id": "overlay_text_column",
      "label": "Overlay Text Column",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left Column"
        },
        {
          "value": "center",
          "label": "Center (Spans Both)"
        },
        {
          "value": "right",
          "label": "Right Column"
        }
      ],
      "info": "Choose which column to overlay text on. Only applies when Overlay Text Position is not 'None'"
    },
    {
      "type": "color",
      "id": "overlay_text_bg_color",
      "label": "Overlay Text Background Color",
      "default": "rgba(0, 0, 0, 0.7)",
      "info": "Background color for overlay text. Only applies when Overlay Text Position is not 'None'"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "css_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID"
    }
  ],
  "blocks": [
    {
      "type": "subtitle",
      "name": "Subtitle",
      "settings": [
        {
          "type": "image_picker",
          "id": "subtitle_image",
          "label": "Subtitle Image"
        },
        {
          "type": "text",
          "id": "subtitle_text",
          "label": "Subtitle Text",
          "default": "Welcome to"
        },
        {
          "type": "color",
          "id": "subtitle_color",
          "label": "Subtitle Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "subtitle_size_desktop",
          "min": 12,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Font Size Desktop",
          "default": 18
        },
        {
          "type": "range",
          "id": "subtitle_size_mobile",
          "min": 10,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Font Size Mobile",
          "default": 16
        },
        {
          "type": "select",
          "id": "subtitle_weight",
          "label": "Font Weight",
          "default": "normal",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "bold", "label": "Bold" },
            { "value": "300", "label": "Light" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi Bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra Bold" }
          ]
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "settings": [
        {
          "type": "richtext",
          "id": "title_text",
          "label": "Title Text",
          "default": "<h1>Your Amazing Hero Title</h1>"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "title_size_desktop",
