{% assign config = '{"loop":false,"slidesPerView":1,"effect":"fade","fadeEffect":{"crossFade":true},"allowTouchMove":false}' %}

<div id="key-ingredients" class="pt-14 -mt-14">
  <div class="bg-[#E5DBCC] py-14 lg:py-20 key-ingredients">
    <div class="site-container px-8 lg:px-16">
      <site-carousel
        data-config="{{ config | escape }}"
        id="exploring-carousel"
        data-id="exploring-carousel"
        class="lg:grid lg:grid-cols-2 lg:gap-20"
      >
        <div class="flex flex-col justify-between items-center">
          <div class="">
            <div class="relative lg:mb-4">
              <h3 class="heading--3 sm:flex sm:flex-col mb-1">
                {{ section.settings.title }}
              </h3>
              {%- if section.settings.double_nutri_logo -%}
                <div class="sm:absolute bottom-0 left-36 h-10 mb-4 sm:mb-0">
                  <div class="relative h-10 mix-blend-multiply">
                    <img class="h-[40px]" src="{{ section.settings.double_nutri_logo | img_url: '500x' }}" loading="lazy" />
                  </div>
                </div>
              {%- endif -%}
            </div>

            <p class="paragraph--2 !text-xs mb-12">
              {{ section.settings.text }}
            </p>
            <div class="lg:hidden">
              <label for="select-ingredient" class="eyebrow">{{ section.settings.mobile_select_label }}</label>
              <div class="relative mt-3 mb-7 max-w-[450px]">
                <select id="select-ingredient" class="select-container-js cursor-pointer w-full py-3 px-4 bg-transparent border appearance-none relative z-10"></select>
                <div class="absolute top-1/2 -translate-y-1/2 right-3">
                  {% render 'icon-expand' %}
                </div>
              </div>
            </div>
          </div>

          <div class="swiper w-full">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.type == 'slide_item' %}
                  <div class="swiper-slide flex items-end">
                    <div class="border-b pb-3 lg:pb-5">
                      <h3 class="heading--3 mb-1 lg:mb-3">
                        {{ block.settings.slide_item_title }}
                      </h3>
                      <p class="eyebrow mb-4">
                        {{ block.settings.slide_item_eyebrow }}
                      </p>
                      <p class="paragraph--2">
                        {{ block.settings.slide_item_text }}
                      </p>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="hidden lg:block">
          <carousel-pager class="max-lg:pl-8 flex overflow-x-auto w-full lg:flex-col gap-9 lg:pl-10">
            {% for block in section.blocks %}
              {% if block.type == 'slide_item' %}
                <button class="group flex flex-col items-start lg:flex-row lg:gap-x-8 lg:w-fit ingredient-button">
                  <div class="max-lg:min-w-56 flex items-center lg:flex-col mb-6 lg:mb-0">
                    <div class="carousel-bullet key-ingredient min-w-4 min-h-4 border flex border-black rounded-full {% if forloop.first %}active{% endif %}"></div>
                  </div>
                  <p class="opacity-50 lg:group-hover:opacity-100 paragraph--2 pr-0.5 uppercase transition-all !text-xs lg:!text-sm duration-300 lg:-mt-0.5 {% if forloop.first %}active{% endif %}">
                    {{ block.settings.slide_item_title }}
                  </p>
                </button>
              {% endif %}
            {% endfor %}
          </carousel-pager>
        </div>
      </site-carousel>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Key Ingredients",
  "tag": "section",
  "presets": [
    {
      "name": "Key Ingredients"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title"
    }, {
      "type": "text",
      "id": "text",
      "label": "Text"
    }, {
      "type": "image_picker",
      "id": "double_nutri_logo",
      "label": "Double Nutri Logo"
    }, {
      "type": "text",
      "id": "mobile_select_label",
      "label": "Mobile Select Label"
    }
  ],
  "blocks": [
    {
      "name": "Slide Item",
      "type": "slide_item",
      "settings": [
        {
          "type": "text",
          "id": "slide_item_title",
          "label": "Slide Item Title"
        }, {
          "type": "text",
          "id": "slide_item_eyebrow",
          "label": "Slide Item Eyebrow"
        }, {
          "type": "text",
          "id": "slide_item_text",
          "label": "Slide Item Text"
        }
      ]
    }
  ]
}
{% endschema %}
