{% schema %}
{
  "name": "Benefits Grid",
  "tag": "section",
  "class": "benefits-section",
  "settings": [
    {"type": "richtext", "id": "heading_main", "label": "Título principal", "default": "<p>WHAT YOU’LL notice first</p>"},
    {"type": "image_picker", "id": "image_1", "label": "Imagem topo esquerdo"},
    {"type": "richtext", "id": "heading_1", "label": "Título bloco 1", "default": "<p>In your body</p>"},
    {"type": "richtext", "id": "bullets_1", "label": "Itens bloco 1 (separados por |)", "default": "<p>Light, sustained energy that carries you through|No highs, no lows, just clean momentum</p>"},
    {"type": "richtext", "id": "heading_2", "label": "Título bloco 2", "default": "<p>In your mind</p>"},
    {"type": "richtext", "id": "bullets_2", "label": "Itens bloco 2 (separados por |)", "default": "<p>Sharper thinking and faster recall|More presence, less mental noise</p>"},
    {"type": "image_picker", "id": "image_2", "label": "Imagem meio direito"},
    {"type": "richtext", "id": "heading_3", "label": "Título bloco 3", "default": "<p>In your flow</p>"},
    {"type": "richtext", "id": "bullets_3", "label": "Itens bloco 3 (separados por |)", "default": "<p>Meetings feel easier|Ideas come quicker|You stay in rhythm</p>"},
    {"type": "image_picker", "id": "image_3", "label": "Imagem base esquerdo"}
  ],
  "blocks": [],
  "presets": [
    {"name": "Benefits Grid"}
  ]
}
{% endschema %}

<style>
.benefits-section { background-color: #f8f5ec; padding: 60px 0; }
.benefits-section h2 { 
  margin-bottom: 2rem; 
  color: #1E1E1E;
                     
        }
.benefits-grid { display: grid; gap: 2rem; grid-template-columns: repeat(1, 1fr); }

  .benefits_tile{
    font-size: 50px;
    margin-bottom: 40px !important;
  }

  .title_benefits{
    font-size: 40px;
  }

  .coluna_grid{
        display: flex;
    flex-direction: column;
    justify-content: center;
    margin-left: 100px;
  } 

  .coluna_grid.diferente{
    margin-left: 0px;
    margin-right: 100px;
    align-items: end;
  }

.benefits-grid img { width: 100%; max-width: 513px; margin-right: auto; }

  .benefits-grid .img_diferente img{
    max-width: 513px;
    margin-left: auto;
  }
@media (min-width: 768px) { .benefits-grid { grid-template-columns: repeat(2, 1fr); } }

.benefits-grid h3 { font-family: serif; font-size: 1.25rem; margin-bottom: 0.5rem; }
.benefits-grid ul { list-style-type: disc; list-style-position: inside; color: #333; }
</style>

<section class="benefits-section" style="border-top: 1px solid #000; padding: 0 1rem;">
  <div class="mx-auto" style="max-width: 1300px;">
    <h2 class="heading benefits_tile">{{ section.settings.heading_main }}</h2>
    <div class="benefits-grid">
      <!-- Bloco 1 -->
      <div>
        {% if section.settings.image_1 != blank %}
          <img src="{{ section.settings.image_1 | image_url }}" alt="{{ section.settings.heading_1 }}" />
        {% endif %}
      </div>
      <div class="coluna_grid">
        <h2 class="heading title_benefits">{{ section.settings.heading_1 }}</h2>
        <ul class="font_surt">
          {% assign items = section.settings.bullets_1 | split: "|" %}
          {% for item in items %}
            <p class="font_surt">{{ item }}</p>
          {% endfor %}
        </ul>
      </div>
      <!-- Bloco 2 -->
      <div class="coluna_grid diferente">
        <h2 class="heading title_benefits">{{ section.settings.heading_2 }}</h2>
        <ul class="font_surt">
          {% assign items2 = section.settings.bullets_2 | split: "|" %}
          {% for item in items2 %}
            <p>{{ item }}</p>
          {% endfor %}
        </ul>
      </div>
      <div class="img_diferente">
        {% if section.settings.image_2 != blank %}
          <img src="{{ section.settings.image_2 | image_url }}" alt="{{ section.settings.heading_2 }}" />
        {% endif %}
      </div>
      <!-- Bloco 3 -->
      <div>
        {% if section.settings.image_3 != blank %}
          <img src="{{ section.settings.image_3 | image_url }}" alt="{{ section.settings.heading_3 }}" />
        {% endif %}
      </div>
      <div class="coluna_grid">
        <h2 class="heading title_benefits">{{ section.settings.heading_3 }}</h2>
        <ul class="font_surt">
          {% assign items3 = section.settings.bullets_3 | split: "|" %}
          {% for item in items3 %}
            <p class="font_surt">{{ item }}</p>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
