{% comment %}
  File: sections/subscription-products.liquid
  Disponível em Customize → Add section → Subscription Products
{% endcomment %}

<script src="{{ 'subscription-widget.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'subscription-widget.css' | asset_url }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>




<section id="subscription-products-{{ section.id }}" class="subscription-products ">
  <div class="subscription-products__inner">
    <h2 class="subscription-products__title heading">{{ section.settings.title }}</h2>
    {% if section.settings.subtitle %}
      <p class="subscription-products__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% assign product_cards   = section.blocks | where: 'type', 'product_card' %}
    {% assign quantity_blocks = section.blocks | where: 'type', 'quantity_block' %}
    {% assign default_qb      = quantity_blocks.first %}

    {%- comment -%} Swiper container no lugar da grid {%- endcomment -%}
    <div class="subscription-products__grid swiper my-mobile-swiper">
      <div class="swiper-wrapper">
        {% for block in product_cards %}
          {% assign product = block.settings.product %}
          {% if product %}
            {% assign current_variant = product.selected_or_first_available_variant %}
            {% assign has_plan = false %}
            {% if current_variant.selling_plan_allocations.size > 0 %}
              {% assign has_plan = true %}
            {% endif %}

            <div class="swiper-slide">
              <div class="subscription-products__card">
                <a href="{{ product.url }}" class="card__image">
                  <img src="{{ product.featured_image | img_url: '600x' }}"
                       alt="{{ product.title }}"
                       loading="lazy" />
                </a>
                <div class="card__info">
                  {% capture product_data_attribute %}
                    data-oke-reviews-product-id="shopify-{{ product.id }}"
                  {% endcapture %}
                  <div data-oke-star-rating {{ product_data_attribute }}>
                    {{ product.metafields.okendo.StarRatingSnippet }}
                  </div>
                  <div class="flex justify-between" style="margin-top: 7px;">
                    <h3 class="card__title">{{ product.title }}</h3>
                    <div class="price-display">
                      <span class="price-original">
                        {{ current_variant.price | money_without_trailing_zeros }}
                      </span>
                      <span class="price-subscription">
                        {% if has_plan %}
                          {{ current_variant.selling_plan_allocations.first.price | money_without_trailing_zeros }}
                        {% else %}
                          {{ current_variant.price | money_without_trailing_zeros }}
                        {% endif %}
                      </span>
                    </div>
                  </div>
                </div>

                <form action="/cart/add" method="post" class="js-subscription-form">
                  <subscription-widget class="subscription-widget">
                    <script type="application/json" data-widget-config>
                      {
                        "product": {
                          "current_variant": {{ current_variant | json }},
                          "selling_plan_groups": {{ product.selling_plan_groups | json }},
                          "is_bundle": false
                        },
                        "defaults": {
                          "quantity": {{ default_qb.settings.quantity }},
                          "cadence": {% if has_plan %}"subscription"{% else %}"one-time-purchase"{% endif %},
                          "plan_id": {{ default_qb.settings.subscription_id }}
                        }
                      }
                    </script>

                    <div class="widget-inputs">
                      <input type="hidden" name="id" value="{{ current_variant.id }}">
                      <input type="hidden" name="quantity"
                             class="js-quantity-input"
                             value="{{ default_qb.settings.quantity }}">
                      {% if has_plan %}
                        <input type="hidden" name="selling_plan"
                               class="js-plan-id"
                               value="{{ default_qb.settings.subscription_id }}">
                      {% endif %}
                    </div>

                    <div class="plan-selector">
                      <select name="selling_plan" class="plan-select js-plan-select">
                        {% for qb in quantity_blocks %}
                          {% if qb.settings.subscription_id %}
                            {% assign plan_obj = nil %}
                            {% for group in product.selling_plan_groups %}
                              {% for p in group.selling_plans %}
                                {% if p.id == qb.settings.subscription_id %}
                                  {% assign plan_obj = p %}
                                {% endif %}
                              {% endfor %}
                            {% endfor %}
                            {% if plan_obj %}
                              {% assign alloc = current_variant.selling_plan_allocations
                                                 | where: 'selling_plan_id', plan_obj.id
                                                 | first %}
                              {% assign sub_cents = alloc.price | default: current_variant.price %}
                              <option
                                value="{{ plan_obj.id }}"
                                data-qty="{{ qb.settings.quantity }}"
                                data-subscription-cents="{{ sub_cents }}"
                                data-onetime-cents="{{ current_variant.price }}"
                                {% if qb == default_qb %}selected{% endif %}
                              >
                                {{ plan_obj.name }} — {{ qb.settings.quantity }} unidades
                              </option>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      </select>

                      <button type="submit"
                              class="button-subscription js-add-to-cart">
                        {{ 'products.product.add_to_cart' | t }}
                      </button>
                    </div>
                  </subscription-widget>
                </form>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Botões de navegação -->
      <button class="swiper-button-prev">
        
      </button>
      <button class="swiper-button-next">
        
      </button>
    </div>

    {% if section.settings.show_all_link %}
      <div class="subscription-products__footer heading">
        <a href="{{ section.settings.all_link_url }}" class="see-all">
          {{ section.settings.all_link_text }}
          <img src="https://cdn.shopify.com/s/files/1/0869/3704/3264/files/ARROW-RIGHT.svg?v=1752313226" width="21" height="19">
        </a>
      </div>
    {% endif %}
  </div>
</section>


<style>
    #subscription-products-{{ section.id }} .subscription-products__grid {
      max-width: 1440px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px,1fr));
      gap: 24px;
      margin:  0 auto;
    }

    .subscription-products__inner{
      max-width: 1440px;
      margin: 0 auto;
    }

    .subscription-products{
      border-top: 1px solid #000;
      padding: 60px 0px;
    }
    .subscription-products__card {
      background: transparent;
      
    }

    .subscription-products__title{
      font-size: 50px !important;
    }
    .card__image img { width:100%; height:auto; }
    .card__info { margin:0.5rem 0; }
    
    .plan-selector { 
      margin:1rem 0; 
      text-align:left;
      display: flex;
      justify-content: space-between;
    }

    .button-subscription{
      max-width: 132px;
      background: #000;
      color: #fff;
      width: 100%;
      height: 32px;
    }
    .plan-select { 
      width: 100%;
      max-width: 174px;
      padding: 0;
      background: transparent;
      border-bottom: 1px solid #707070;
      padding:.5rem;
    }
    .price-display { 
      margin-top:.5rem; 
      font-weight: 400;
      color: #1E1E1E;
      font-size: 16px;
      line-height: 20px;
    }
    .price-original { 
      text-decoration: line-through;
      margin-right: .5rem;
      color: #989898;
      font-size: 14px;
      font-weight: 300;
    }

  .okeReviews[data-oke-container], div.okeReviews{
    line-height: inherit !important;
  }

    .see-all{
      display: flex;
      justify-content: end;
      gap: 10px;
    }

    .subscription-products__footer{
      font-size: 24px;
      text-align: right;
      margin-top: 50px;
    }

  @media (max-width: 900px){
    .mobile{
      display: none;
    }

    .subscription-products__inner{
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  @media (min-width: 901px){
    .desktop{
      display: none;
    }
  }

  @media screen and (max-width: 767px) {
  /* Anula o grid original e esconde o overflow */
  .subscription-products__grid.swiper {
    display: block !important;
    overflow: hidden;
    width: 100%;
    position: relative; /* já havia em .my-mobile-swiper */
    padding-bottom: 60px;
  }

  /* Garante que o wrapper use flex e que cada slide não encolha */
  .subscription-products__grid.swiper .swiper-wrapper {
    display: flex;
  }
  .subscription-products__grid.swiper .swiper-slide {
    flex-shrink: 0;
    
  }

  /* Seus botões têm position:absolute e devem estar visíveis */
  .subscription-products__grid.swiper .swiper-button-prev,
  .subscription-products__grid.swiper .swiper-button-next {
    z-index: 10;
    pointer-events: auto;
    top: 98% !important;
  }

    
}

  </style>

  <script>
   document.addEventListener('DOMContentLoaded', () => {
  // sempre inicializa o Swiper
  const subscriptionSwiper = new Swiper('.my-mobile-swiper', {
    // padrão para <768px
    slidesPerView: 1,
    spaceBetween: 16,

    // navegação
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },

    // quando ≥768px, mostra 4 colunas
    breakpoints: {
      768: {
        slidesPerView: 4,
        spaceBetween: 24,
      }
    }
  });
});


  </script>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.js-plan-select').forEach(function(select) {
      var card   = select.closest('.subscription-products__card');
      var qtyIn  = card.querySelector('.js-quantity-input');
      var planIn = card.querySelector('.js-plan-id');
      var origEl = card.querySelector('.price-original');
      var subsEl = card.querySelector('.price-subscription');
      var widget = card.querySelector('subscription-widget');

      function render(option) {
        var planId = Number(option.value);
        var qty    = Number(option.dataset.qty);
        var variant = widget.config.product.current_variant;

        // encontrar alocação para este planId
        var alloc = variant.selling_plan_allocations.find(function(a){
          return a.selling_plan_id === planId;
        });

        var oneCents = variant.price;
        // usa `alloc.price` (cents) quando disponível
        var subCents = alloc ? alloc.price : oneCents;

        qtyIn.value    = qty;
        planIn.value   = planId;

        // atualiza o widget interno
        widget.state.quantity       = qty;
        widget.state.selectedPlanId = planId;
        widget.refresh();

        origEl.textContent = widget.formatPrice(oneCents);
        subsEl.textContent = widget.formatPrice(subCents);
      }

      // inicialização
      render(select.selectedOptions[0]);

      select.addEventListener('change', function() {
        render(this.selectedOptions[0]);
      });
    });

    

   

  });

    // AJAX add to cart + alert + reload
      document.querySelectorAll('.js-subscription-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var data = {
            id:            form.querySelector('[name="id"]').value,
            quantity:      form.querySelector('[name="quantity"]').value,
            selling_plan: form.querySelector('[name="selling_plan"]').value
          };
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          })
          .then(function() {
            alert('Produto adicionado ao carrinho!');
            window.location.reload();
          })
          .catch(function() {
            alert('Erro ao adicionar ao carrinho.');
          });
        });
      });
</script>

{% schema %}
{
  "name": "Subscription Products",
  "settings": [
    {"type":"richtext","id":"title","label":"Título da seção","default":"<h2>Complete your routine</h2>"},
    {"type":"text","id":"subtitle","label":"Subtítulo (opcional)"},
    {"type":"url","id":"all_link_url","label":"Link 'See All products'","default":"/collections/all"},
    {"type":"richtext","id":"all_link_text","label":"Texto do link 'See All'","default":"<h2>SEE ALL products</h2>"},
    {"type":"checkbox","id":"show_all_link","label":"Exibir link de ver todos","default":true}
  ],
  "blocks": [
    {
      "type":"product_card",
      "name":"Product Card",
      "settings":[{"type":"product","id":"product","label":"Produto"}]
    },
    {
      "type":"quantity_block",
      "name":"Quantidade & Plano",
      "settings":[
        {"type":"number","id":"quantity","label":"Quantidade","default":1},
        {"type":"number","id":"subscription_id","label":"ID do Selling Plan"}
      ]
    }
  ],
  "presets":[{"name":"Subscription Products","category":"Custom"}]
}
{% endschema %}
