{% comment %}
  Seção: Ingredients Tabs
  Cria uma lista de abas à esquerda e o conteúdo correspondente à direita.
{% endcomment %}

<section id="ingredients-tabs-{{ section.id }}" class="ingredients-tabs-section">
  <div class="ingredients-tabs-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ingredients-tabs-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ingredients-tabs-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="ingredients-tabs-wrap">
      <ul class="ingredients-tabs-list">
        {%- for block in section.blocks -%}
          <li
            class="ingredients-tab-item{% if forloop.first %} active{% endif %}"
            data-tab="tab-{{ block.id }}"
          >
            {{ block.settings.tab_title }}
          </li>
        {%- endfor -%}
      </ul>

      <div class="ingredients-tabs-content">
        {%- for block in section.blocks -%}
          <div
            id="tab-{{ block.id }}"
            class="ingredients-tab-panel{% if forloop.first %} active{% endif %}"
          >
            {%- if block.settings.tab_heading != blank -%}
              <h3 class="ingredients-tab-panel-heading">
                {{ block.settings.tab_heading }}
              </h3>
            {%- endif -%}
            {%- if block.settings.tab_text != blank -%}
              <div class="ingredients-tab-panel-text">
                {{ block.settings.tab_text }}
              </div>
            {%- endif -%}
            {%- if block.settings.tab_image -%}
              <div class="ingredients-tab-panel-image">
                <img
                  src="{{ block.settings.tab_image | img_url: 'master' }}"
                  alt="{{ block.settings.tab_title }}"
                >
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    // Tab switching JS escopado à esta seção
    (function(){
      var sectionEl = document.getElementById('ingredients-tabs-{{ section.id }}');
      if (!sectionEl) return;
      var tabs = sectionEl.querySelectorAll('.ingredients-tab-item');
      var panels = sectionEl.querySelectorAll('.ingredients-tab-panel');

      tabs.forEach(function(tab){
        tab.addEventListener('click', function(){
          var target = tab.getAttribute('data-tab');

          tabs.forEach(function(t){ t.classList.remove('active'); });
          panels.forEach(function(p){ p.classList.remove('active'); });

          tab.classList.add('active');
          sectionEl.querySelector('#' + target).classList.add('active');
        });
      });
    })();
  </script>
</section>

<style>
 /* === Ingredients Tabs – Ajustes Finais === */
.ingredients-tabs-section {
  padding: 6rem 1rem;             /* mais “respiro” acima e abaixo */
  background-color: #f6f2e8;
}

.ingredients-tabs-inner {
  max-width: 1280px;              /* um pouco mais largo */
  margin: 0 auto;
}

/* Cabeçalho */
.ingredients-tabs-heading {
  font-family: 'Playfair Display', serif;
  font-size: 2.25rem;             /* ligeiramente menor para encaixar */
  line-height: 1.2;
  text-align: center;
  margin-bottom: 0.5rem;
}

.ingredients-tabs-subheading {
  font-style: italic;
  font-size: 1rem;
  line-height: 1.3;
  text-align: center;
  margin-bottom: 3rem;            /* mais espaço para a área de tabs */
  color: #555;
}

/* Grid das cols: lista mais estreita, conteúdo maior */
.ingredients-tabs-wrap {
  display: grid;
  grid-template-columns: 1fr 2.5fr;
  gap: 3rem;
}

/* Lista de abas */
.ingredients-tabs-list {
  list-style: none;
  padding: 0;
  margin: 0;
  border-right: 1px solid rgba(0,0,0,0.1);
}

.ingredients-tab-item {
  font-family: 'Playfair Display', serif;
  font-size: 1.125rem;            /* um pouco maior */
  line-height: 1.4;
  text-transform: uppercase;      /* conforme mock */
  letter-spacing: 1px;
  padding: 1.25rem 0;             /* mais espaçamento vertical */
  cursor: pointer;
  color: #aaa;
  position: relative;
  border-bottom: 1px solid rgba(0,0,0,0.05); /* divisores sutis */
  transition: color .2s;
}

.ingredients-tab-item:hover {
  color: #666;
}

.ingredients-tab-item.active {
  color: #333;
  font-weight: 600;
}

.ingredients-tab-item.active::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 100%;
  height: 3px;                    /* underline um pouco mais grosso */
  background-color: #333;
}

/* Painéis de conteúdo */
.ingredients-tabs-content {
  position: relative;
  padding-left: 2rem;             /* espaço antes da borda */
  border-left: 2px solid rgba(0,0,0,0.1);
}

.ingredients-tab-panel {
  display: none;
}

.ingredients-tab-panel.active {
  display: block;
}

.ingredients-tab-panel-heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;              /* ajuste fino */
  line-height: 1.3;
  margin-bottom: 1rem;
}

.ingredients-tab-panel-text {
  font-family: 'Open Sans', sans-serif;
  font-size: 1rem;                /* ficando maior e mais legível */
  line-height: 1.7;
  margin-bottom: 2rem;            /* mais espaço antes da imagem */
  color: #333;
}

/* Imagem do painel */
.ingredients-tab-panel-image img {
  width: 100%;
  max-height: 400px;              /* controla o tamanho vertical */
  object-fit: cover;
  border-radius: 0.5rem;
}

/* Responsivo */
@media (max-width: 767px) {
  .ingredients-tabs-wrap {
    grid-template-columns: 1fr;
  }
  .ingredients-tabs-list {
    display: flex;
    overflow-x: auto;
    border-right: none;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .ingredients-tab-item {
    flex: none;
    padding: 0.75rem 1rem;
    border-bottom: none;
    border-right: 1px solid rgba(0,0,0,0.05);
  }
  .ingredients-tabs-content {
    padding-left: 0;
    border-left: none;
    margin-top: 2rem;
  }
}


</style>

{% schema %}
{
  "name": "Ingredients Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "THOUGHTFULLY SOURCED,"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Texto menor (italic)",
      "default": "clinically-verified ingredients"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Título da aba",
          "default": "MAGNESIUM BISGLYCINATE"
        },
        {
          "type": "text",
          "id": "tab_heading",
          "label": "Cabeçalho do painel",
          "default": "Magnesium Bisglycinate"
        },
        {
          "type": "richtext",
          "id": "tab_text",
          "label": "Texto do painel",
          "default": "<p>Your brain’s favorite form of magnesium. Absorbs fast to sharpen focus, steady mood and relax tight muscles without upsetting your stomach.</p>"
        },
        {
          "type": "image_picker",
          "id": "tab_image",
          "label": "Imagem do painel"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ingredients Tabs",
      "category": "Custom"
    }
  ]
}
{% endschema %}
