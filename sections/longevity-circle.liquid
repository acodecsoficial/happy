<section class="longevity-circle" id="longevity-circle-{{ section.id }}">
  <div class="longevity-circle__inner">
    {%- if section.blocks.size > 0 -%}

      <!-- MAIN SLIDER -->
      <div class="swiper-container main-slider" id="main-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="longevity-circle__slide">
                <div class="longevity-circle__slide-text">
                  <!-- richtext para título -->
                  <div class="longevity-circle__block-title">
                    <h2 class="heading">{{ block.settings.block_title }}</h2>
                  </div>
                  <div class="flex">
                    <!-- richtext para subtítulo -->
                    <div class="longevity-circle__block-subtitle">
                      <h2 class="heading">{{ block.settings.block_subtitle }}</h2>
                    </div>
                    <!-- richtext para subtítulo2 -->
                    <div class="longevity-circle__block-subtitle2">
                      <h3 class="heading">{{ block.settings.block_subtitle2 }}</h3>
                    </div>
                  </div>
                  <!-- richtext para descrição -->
                  <div class="longevity-circle__block-description">
                    {{ block.settings.block_description }}
                  </div>
                </div>
                <div class="longevity-circle__slide-image">
                  <img
                    src="{{ block.settings.image | img_url: '600x' }}"
                    alt="{{ block.settings.alt }}"
                  />
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- THUMBS SLIDER -->
      <div class="swiper-container thumbs-slider" id="thumbs-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <img
                src="{{ block.settings.image | img_url: '100x' }}"
                alt="{{ block.settings.alt }}"
              />
            </div>
          {% endfor %}
        </div>
      </div>

    {%- endif -%}
  </div>

    <style>
    /* 1) Slider principal full‑width, 1 por vez */
    #longevity-circle-{{ section.id }} .main-slider,
    #longevity-circle-{{ section.id }} .thumbs-slider {
      width: 100%;
    }
    #longevity-circle-{{ section.id }} .main-slider .swiper-slide {
      width: 100% !important;
    }

    /* 2) Layout do conteúdo do slide */
    .longevity-circle__slide {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    /* 3) Thumbs mais juntinhas e alinhadas */
    #longevity-circle-{{ section.id }} .thumbs-slider {
      margin-top: 1rem;             /* menos espaço acima */
    }
    #longevity-circle-{{ section.id }} .thumbs-slider .swiper-wrapper {
      display: flex;
      align-items: center;
    }
    #longevity-circle-{{ section.id }} .thumbs-slider .swiper-slide {
      width: auto !important;
      margin-right: 10px;           /* gap entre thumbs */
      opacity: 0.4;
      cursor: pointer;
    }
    #longevity-circle-{{ section.id }} .thumbs-slider .swiper-slide-thumb-active {
      opacity: 1;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // 1) Inicia thumbs
      var thumbs = new Swiper('#thumbs-{{ section.id }}', {
        spaceBetween: 10,
        slidesPerView: 'auto',
        freeMode: true,
        watchSlidesProgress: true,
        centeredSlides: false,
      });

      // 2) Inicia main ligado ao thumbs
      new Swiper('#main-{{ section.id }}', {
        slidesPerView: 1,
        spaceBetween: 20,
        centeredSlides: false,
        loop: false,
        initialSlide: 0,
        thumbs: { swiper: thumbs }
      });
    });
  </script>


{% schema %}
{
  "name": "Longevity Circle",
  "settings": [],
  "blocks": [
    {
      "type": "bottle",
      "name": "Frasco",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem do frasco"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "richtext",
          "id": "block_title",
          "label": "Título do slide",
          "default": "<p>WELCOME TO THE longevity circle</p>"
        },
        {
          "type": "richtext",
          "id": "block_subtitle",
          "label": "Subtítulo do slide",
          "default": "<p>LIPOSOMAL magnesium — CALM TONIC</p>"
        },
        {
          "type": "richtext",
          "id": "block_subtitle2",
          "label": "Subtítulo 2 do slide",
          "default": "<p>CALM TONIC</p>"
        },
        {
          "type": "richtext",
          "id": "block_description",
          "label": "Descrição do slide",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit…</p>"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Longevity Circle", "category": "Custom" }
  ]
}
{% endschema %}
