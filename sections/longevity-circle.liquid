<section class="longevity-circle" id="longevity-circle-{{ section.id }}">
  <div class="longevity-circle__inner">
    {%- if section.blocks.size > 0 -%}

      <!-- MAIN SLIDER -->
      <div class="swiper-container main-slider" id="main-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="longevity-circle__slide">
                <div class="longevity-circle__slide-text">
                  <h3 class="longevity-circle__block-title">
                    {{ block.settings.block_title }}
                  </h3>
                  <h4 class="longevity-circle__block-subtitle">
                    {{ block.settings.block_subtitle }}
                  </h4>
                  <div class="longevity-circle__block-description">
                    {{ block.settings.block_description }}
                  </div>
                </div>
                <div class="longevity-circle__slide-image">
                  <img
                    src="{{ block.settings.image | img_url: '600x' }}"
                    alt="{{ block.settings.alt }}"
                  />
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- THUMBS SLIDER -->
      <div class="swiper-container thumbs-slider" id="thumbs-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <img
                src="{{ block.settings.image | img_url: '100x' }}"
                alt="{{ block.settings.alt }}"
              />
            </div>
          {% endfor %}
        </div>
      </div>

    {%- endif -%}
  </div>

  <style>
    #longevity-circle-{{ section.id }} {
      padding: 60px 0;
      border-top: 1px solid #000;
    }
    .longevity-circle__inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .longevity-circle__slide {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
    .longevity-circle__slide-text {
      flex: 1;
    }
    .longevity-circle__block-title {
      font-size: 50px;
      margin-bottom: .5em;
    }
    .longevity-circle__block-subtitle {
      font-style: italic;
      margin-bottom: .5em;
    }
    .longevity-circle__block-description {
      font-size: 16px;
      line-height: 1.5;
    }
    .longevity-circle__slide-image img {
      max-height: 400px;
      object-fit: contain;
    }
    /* Thumbnails */
    .thumbs-slider {
      margin-top: 2rem;
    }
    .thumbs-slider .swiper-slide {
      width: auto;
      opacity: 0.4;
      cursor: pointer;
    }
    .thumbs-slider .swiper-slide-thumb-active {
      opacity: 1;
    }
    .thumbs-slider img {
      display: block;
      height: 80px;
      object-fit: contain;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var thumbs = new Swiper('#thumbs-{{ section.id }}', {
        spaceBetween: 10,
        slidesPerView: 'auto',
        freeMode: true,
        watchSlidesProgress: true,
      });
      new Swiper('#main-{{ section.id }}', {
        spaceBetween: 20,
        navigation: false,
        thumbs: { swiper: thumbs },
      });
    });
  </script>

{% schema %}
{
  "name": "Longevity Circle",
  "settings": [],
  "blocks": [
    {
      "type": "bottle",
      "name": "Frasco",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem do frasco"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Título do slide",
          "default": "WELCOME TO THE longevity circle"
        },
        {
          "type": "text",
          "id": "block_subtitle",
          "label": "Subtítulo do slide",
          "default": "LIPOSOMAL magnesium — CALM TONIC"
        },
        {
          "type": "textarea",
          "id": "block_description",
          "label": "Descrição do slide",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit…"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Longevity Circle", "category": "Custom" }
  ]
}
{% endschema %}
