<section
  id="easy-to-take-{{ section.id }}"
  class="easy-to-take-section"
  style="background-image: url('{{ section.settings.desktop_image | img_url: '2048x' }}');"
>
  <style>
    /* Troca a bg para mobile quando em tela pequena */
    @media (max-width: 767px) {
      #easy-to-take-{{ section.id }} {
        background-image: url('{{ section.settings.mobile_image | img_url: '800x' }}') !important;
      }
    }
  </style>

  <div class="easy-to-take-inner">
    <div class="easy-to-take-content">
      {% if section.settings.title != blank %}
        <h2 class="easy-to-take-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="easy-to-take-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  /* === Easy to Take Section === */
.easy-to-take-section {
  padding: 7rem 1rem;
  background-color: #F8F4EC;
  min-height: 400px;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: right center;
  display: flex;
  border-top: 1px solid #000;
}
.easy-to-take-inner {
  max-width: 1280px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 2rem;
}
.easy-to-take-content {
  z-index: 2;
}
.easy-to-take-title {
  font-size: 60px;
  line-height: 1.2;
  margin-bottom: 1rem;
  font-style: italic;
}
.easy-to-take-subtitle {
  font-size: 16px;
  line-height: 1.6;
  color: #202020;
  max-width: 484px;
}

/* Wrapper da imagem de fundo */
.easy-to-take-image-wrapper {
  position: relative;
  width: 100%;
  height: 400px; /* ajuste conforme o mock */
}
.easy-to-take-bg {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background-size: cover;
  background-position: center;
}

/* só desktop */
.easy-to-take-bg--mobile { display: none; }

/* responsivo */
@media (max-width: 767px) {
  .easy-to-take-inner {
    grid-template-columns: 1fr;
  }
  .easy-to-take-image-wrapper {
    height: 250px; /* ajuste para mobile */
  }
  .easy-to-take-bg--desktop { display: none; }
  .easy-to-take-bg--mobile { display: block; }

  .easy-to-take-title {
  font-size: 48px;
  line-height: 1.2;
  margin-bottom: 1rem;
  font-style: italic;
}
.easy-to-take-subtitle {
  font-size: 16px;
  line-height: 1.6;
  color: #202020;
  max-width: 484px;
}
  .easy-to-take-section {
  padding: 6rem 20px;
  background-color: #F8F4EC;
  min-height: 692px;
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  display: flex;
  align-items: start;
}
}

</style>

{% schema %}
{
  "name": "Easy to Take",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "EASY TO TAKE, hard to beat"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "one 6 ml tonic, 200mg of quercetin, fast support with clean ingredients."
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Imagem de fundo (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem de fundo (mobile)"
    }
  ],
  "presets": [
    {
      "name": "Easy to Take",
      "category": "Custom"
    }
  ]
}
{% endschema %}
