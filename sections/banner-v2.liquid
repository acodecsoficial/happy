<div class="{% if section.settings.show_border_top %}border-t border-black{% endif %} py-16 pt-8">
  <div class="site-container">
    <div class="lg:px-0">
      
      {%- comment -%} Image Container (robusto com <picture>) {%- endcomment -%}
      <div>
        {% if section.settings.image_desk or section.settings.image_mob %}
          <div class="relative w-full" style="padding-top:40%;"> {# 40% ~ 2.5:1 #}
            <div class="absolute inset-0">
              <picture class="block w-full h-full">
                {%- comment -%} Fonte para telas ≥1024px (desktop) {%- endcomment -%}
                {% if section.settings.image_desk %}
                  <source media="(min-width: 1024px)" srcset="{{ section.settings.image_desk | image_url: width: 2000 }}">
                {% endif %}

                {%- comment -%} Fallback <img>: usa mobile se existir, senão desktop {%- endcomment -%}
                {% if section.settings.image_mob %}
                  {{ section.settings.image_mob
                    | image_url: width: 1800
                    | image_tag: class: 'w-full h-full object-cover', loading: 'lazy', alt: section.settings.title | strip_html | escape
                  }}
                {% else %}
                  {{ section.settings.image_desk
                    | image_url: width: 1800
                    | image_tag: class: 'w-full h-full object-cover', loading: 'lazy', alt: section.settings.title | strip_html | escape
                  }}
                {% endif %}
              </picture>
            </div>
          </div>
        {% else %}
          {%- comment -%} Placeholders se nenhuma imagem estiver setada {%- endcomment -%}
          <div class="hidden lg:block" style="height: 20vw;">
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'w-full h-full' }}
          </div>
          <div class="lg:hidden">
            {{ 'collection-apparel-2' | placeholder_svg_tag: 'w-full' }}
          </div>
        {% endif %}
      </div>

      {%- comment -%} Text Container {%- endcomment -%}
      <div class="flex flex-col lg:flex-row justify-between items-start pt-6 lg:pt-10">
        <div class="flex flex-col max-w-[490px]">
          
          {% if section.settings.eyebrow_text != blank %}
            <div class="eyebrow mb-4">{{ section.settings.eyebrow_text }}</div>
          {% endif %}

          {% if section.settings.title != blank %}
            <div class="flex flex-col lg:flex-row items-baseline gap-2 mb-6">
              <h2 class="heading text-[50px]">{{ section.settings.title }}</h2>
            </div>
          {% endif %}

          {% if section.settings.body_text != blank %}
            <div class="rte li-circle">{{ section.settings.body_text }}</div>
          {% endif %}
        </div>

        {% unless section.settings.cta_link == blank or section.settings.cta_text == blank %}
          <a
            class="button mx-auto lg:mx-0 mt-10 lg:mt-0 {% if section.settings.button_color == 'cream' %}button--cream{% else %}button--black{% endif %}"
            href="{{ section.settings.cta_link }}"
            title="{{ section.settings.cta_text }}"
          >
            {{ section.settings.cta_text }}
          </a>
        {% endunless %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner v2",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desk",
      "label": "Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mob",
      "label": "Image Mobile"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "WHY WAIT?"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading Text",
      "default": "<p>YOUR CALM <em>starts now</em></p>"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Don't let stress hold you back. With Calm Shot, you can approach every challenge with clarity, focus, and peace of mind. Take control today! Try Calm Shot and experience the difference!</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button Color",
      "default": "black",
      "options": [
        { "value": "black", "label": "Black" },
        { "value": "cream", "label": "Cream" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show Top Border",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Banner v2",
      "settings": {}
    }
  ]
}
{% endschema %}
