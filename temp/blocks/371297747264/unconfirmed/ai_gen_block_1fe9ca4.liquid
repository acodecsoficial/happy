{% doc %}
  @prompt
    Uma seção com imagem do lado esquerdo e texto do lado direito para inserirmos a biografia do médico fundador. Responsivo para mobile e desktop em inglês. Mantenha as fontes e tamanhos coerentes com o restante da página, assim como a formatação da imagem, mantenha as mesmas fontes do restante da página, as fontes estão diferentes. Coloque opção para selecionar a fonte de cada bloco, incluindo Doctor Name e title. Deixe o bloco responsivo, as opções de fontes devem ser as padrões já usadas no tema, as fontes estão incorretas. Não são as mesmas nesta página, Mantenha a formatação de titulos e textos conforme o restante da página

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-doctor-bio-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
  }

  .ai-doctor-bio-image-{{ ai_gen_id }} {
    flex: 0 0 50%;
    max-width: 50%;
  }

  .ai-doctor-bio-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ settings.media_radius }}px;
    border: {{ settings.media_border_thickness }}px solid rgba({{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'red' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'green' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'blue' }}, {{ settings.media_border_opacity | divided_by: 100.0 }});
    box-shadow: {{ settings.media_shadow_horizontal_offset }}px {{ settings.media_shadow_vertical_offset }}px {{ settings.media_shadow_blur }}px rgba({{ settings.color_schemes[settings.card_color_scheme].settings.shadow | color_extract: 'red' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.shadow | color_extract: 'green' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.shadow | color_extract: 'blue' }}, {{ settings.media_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-doctor-bio-image-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-doctor-bio-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba({{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'red' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'green' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'blue' }}, 0.04);
  }

  .ai-doctor-bio-image-placeholder-{{ ai_gen_id }} svg {
    width: 40%;
    height: 40%;
    opacity: 0.2;
  }

  .ai-doctor-bio-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-doctor-bio-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.name_font.family }}, {{ block.settings.name_font.fallback_families }};
    font-weight: {{ block.settings.name_font.weight }};
    font-style: {{ block.settings.name_font.style }};
    font-size: calc({{ settings.heading_scale }}% * {{ block.settings.name_size }}px / 100);
    line-height: 1.3;
    margin: 0 0 8px 0;
    color: rgb({{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'red' }}, {{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'green' }}, {{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'blue' }});
  }

  .ai-doctor-bio-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: calc({{ settings.body_scale }}% * {{ block.settings.title_size }}px / 100);
    line-height: 1.4;
    margin: 0 0 24px 0;
    color: rgb({{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'red' }}, {{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'green' }}, {{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'blue' }});
    opacity: 0.8;
  }

  .ai-doctor-bio-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-style: {{ block.settings.text_font.style }};
    font-size: calc({{ settings.body_scale }}% * {{ block.settings.text_size }}px / 100);
    line-height: 1.6;
    color: rgb({{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'red' }}, {{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'green' }}, {{ settings.color_schemes[block.settings.color_scheme].settings.text | color_extract: 'blue' }});
  }

  .ai-doctor-bio-text-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-doctor-bio-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-doctor-bio-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }

    .ai-doctor-bio-image-{{ ai_gen_id }} {
      flex: none;
      max-width: 280px;
      margin: 0 auto;
    }

    .ai-doctor-bio-image-wrapper-{{ ai_gen_id }} {
      padding-bottom: 100%;
    }

    .ai-doctor-bio-content-{{ ai_gen_id }} {
      flex: none;
    }
  }
{% endstyle %}

<div 
  class="ai-doctor-bio-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-doctor-bio-image-{{ ai_gen_id }}">
    <div class="ai-doctor-bio-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.doctor_image %}
        <img
          src="{{ block.settings.doctor_image | image_url: width: 600 }}"
          alt="{{ block.settings.doctor_image.alt | default: block.settings.doctor_name | escape }}"
          loading="lazy"
          width="{{ block.settings.doctor_image.width }}"
          height="{{ block.settings.doctor_image.height }}"
        >
      {% else %}
        <div class="ai-doctor-bio-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="ai-doctor-bio-content-{{ ai_gen_id }}">
    {% if block.settings.doctor_name != blank %}
      <h2 class="ai-doctor-bio-name-{{ ai_gen_id }}">{{ block.settings.doctor_name }}</h2>
    {% endif %}

    {% if block.settings.doctor_title != blank %}
      <p class="ai-doctor-bio-title-{{ ai_gen_id }}">{{ block.settings.doctor_title }}</p>
    {% endif %}

    {% if block.settings.doctor_bio != blank %}
      <div class="ai-doctor-bio-text-{{ ai_gen_id }}">
        {{ block.settings.doctor_bio }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Doctor biography",
  "settings": [
    {
      "type": "header",
      "content": "Doctor information"
    },
    {
      "type": "image_picker",
      "id": "doctor_image",
      "label": "Doctor photo"
    },
    {
      "type": "text",
      "id": "doctor_name",
      "label": "Doctor name",
      "default": "Dr. John Smith"
    },
    {
      "type": "text",
      "id": "doctor_title",
      "label": "Professional title",
      "default": "Founder & Medical Director"
    },
    {
      "type": "richtext",
      "id": "doctor_bio",
      "label": "Biography",
      "default": "<p>Dr. John Smith is a board-certified physician with over 15 years of experience in medical practice. He founded our clinic with a vision to provide personalized, compassionate care to every patient.</p><p>He graduated from Harvard Medical School and completed his residency at Johns Hopkins Hospital. Dr. Smith is passionate about preventive medicine and believes in treating the whole person, not just the symptoms.</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "name_font",
      "label": "Doctor name font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "name_size",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Doctor name size",
      "default": 28
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 18
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Biography font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Biography text size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Doctor biography"
    }
  ],
  "tag": null
}
{% endschema %}