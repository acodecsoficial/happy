{% doc %}
  @prompt
    Uma seção com imagem do lado esquerdo e texto do lado direito para inserirmos a biografia do médico fundador. Responsivo para mobile e desktop em inglês. Mantenha as fontes e tamanhos coerentes com o restante da página, assim como a formatação da imagem, mantenha as mesmas fontes do restante da página, as fontes estão diferentes. Coloque opção para selecionar a fonte de cada bloco, incluindo Doctor Name e title. Deixe o bloco responsivo, as opções de fontes devem ser as padrões já usadas no tema, as fontes estão incorretas. Não são as mesmas nesta página, Mantenha a formatação de titulos e textos conforme o restante da página

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-doctor-bio-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    max-width: 100%;
    padding: 60px 0;
  }

  .ai-doctor-bio-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: {{ settings.media_radius }}px;
    overflow: hidden;
    border: {{ settings.media_border_thickness }}px solid rgba({{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'red' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'green' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.text | color_extract: 'blue' }}, {{ settings.media_border_opacity | divided_by: 100.0 }});
    {% if settings.media_shadow_opacity > 0 %}
      box-shadow: {{ settings.media_shadow_horizontal_offset }}px {{ settings.media_shadow_vertical_offset }}px {{ settings.media_shadow_blur }}px rgba({{ settings.color_schemes[settings.card_color_scheme].settings.shadow | color_extract: 'red' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.shadow | color_extract: 'green' }}, {{ settings.color_schemes[settings.card_color_scheme].settings.shadow | color_extract: 'blue' }}, {{ settings.media_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-doctor-bio-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-doctor-bio-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-doctor-bio-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-doctor-bio-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-doctor-bio-title-{{ ai_gen_id }} {
    {% if block.settings.name_font == 'heading' %}
      font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      font-weight: {{ settings.type_header_font.weight }};
      font-style: {{ settings.type_header_font.style }};
    {% else %}
      font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      font-weight: {{ settings.type_body_font.weight }};
      font-style: {{ settings.type_body_font.style }};
    {% endif %}
    font-size: calc({{ block.settings.name_font_size }}px * {{ settings.heading_scale | divided_by: 100.0 }});
    line-height: 1.2;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-doctor-bio-subtitle-{{ ai_gen_id }} {
    {% if block.settings.title_font == 'heading' %}
      font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      font-weight: {{ settings.type_header_font.weight }};
      font-style: {{ settings.type_header_font.style }};
    {% else %}
      font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      font-weight: {{ settings.type_body_font.weight }};
      font-style: {{ settings.type_body_font.style }};
    {% endif %}
    font-size: calc({{ block.settings.title_font_size }}px * {{ settings.body_scale | divided_by: 100.0 }});
    color: {{ block.settings.accent_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-doctor-bio-description-{{ ai_gen_id }} {
    {% if block.settings.description_font == 'heading' %}
      font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      font-weight: {{ settings.type_header_font.weight }};
      font-style: {{ settings.type_header_font.style }};
    {% else %}
      font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      font-weight: {{ settings.type_body_font.weight }};
      font-style: {{ settings.type_body_font.style }};
    {% endif %}
    font-size: calc({{ block.settings.description_font_size }}px * {{ settings.body_scale | divided_by: 100.0 }});
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-doctor-bio-description-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-doctor-bio-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-doctor-bio-credentials-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-doctor-bio-credential-{{ ai_gen_id }} {
    {% if block.settings.credentials_font == 'heading' %}
      font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      font-weight: {{ settings.type_header_font.weight }};
      font-style: {{ settings.type_header_font.style }};
    {% else %}
      font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      font-weight: {{ settings.type_body_font.weight }};
      font-style: {{ settings.type_body_font.style }};
    {% endif %}
    font-size: calc({{ block.settings.credentials_font_size }}px * {{ settings.body_scale | divided_by: 100.0 }});
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-doctor-bio-credential-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    color: {{ block.settings.accent_color }};
    flex-shrink: 0;
  }

  @media screen and (max-width: 990px) {
    .ai-doctor-bio-{{ ai_gen_id }} {
      gap: 40px;
      padding: 50px 0;
    }

    .ai-doctor-bio-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.name_font_size | times: 0.9 }}px * {{ settings.heading_scale | divided_by: 100.0 }});
    }

    .ai-doctor-bio-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size | times: 0.9 }}px * {{ settings.body_scale | divided_by: 100.0 }});
    }

    .ai-doctor-bio-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_font_size | times: 0.95 }}px * {{ settings.body_scale | divided_by: 100.0 }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-doctor-bio-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 40px 0;
    }

    {% if block.settings.mobile_layout == 'image_top' %}
      .ai-doctor-bio-image-wrapper-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-doctor-bio-content-{{ ai_gen_id }} {
        order: 2;
      }
    {% else %}
      .ai-doctor-bio-content-{{ ai_gen_id }} {
        order: 1;
      }
      .ai-doctor-bio-image-wrapper-{{ ai_gen_id }} {
        order: 2;
      }
    {% endif %}

    .ai-doctor-bio-image-wrapper-{{ ai_gen_id }} {
      max-width: 280px;
      margin: 0 auto;
    }

    .ai-doctor-bio-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.name_font_size | times: 0.8 }}px * {{ settings.heading_scale | divided_by: 100.0 }});
      text-align: center;
    }

    .ai-doctor-bio-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size | times: 0.85 }}px * {{ settings.body_scale | divided_by: 100.0 }});
      text-align: center;
    }

    .ai-doctor-bio-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_font_size | times: 0.9 }}px * {{ settings.body_scale | divided_by: 100.0 }});
    }

    .ai-doctor-bio-credential-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.credentials_font_size | times: 0.9 }}px * {{ settings.body_scale | divided_by: 100.0 }});
    }

    .ai-doctor-bio-content-{{ ai_gen_id }} {
      gap: 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-doctor-bio-{{ ai_gen_id }} {
      padding: 30px 0;
      gap: 25px;
    }

    .ai-doctor-bio-image-wrapper-{{ ai_gen_id }} {
      max-width: 240px;
    }

    .ai-doctor-bio-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.name_font_size | times: 0.7 }}px * {{ settings.heading_scale | divided_by: 100.0 }});
    }

    .ai-doctor-bio-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size | times: 0.75 }}px * {{ settings.body_scale | divided_by: 100.0 }});
    }

    .ai-doctor-bio-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_font_size | times: 0.85 }}px * {{ settings.body_scale | divided_by: 100.0 }});
    }

    .ai-doctor-bio-credential-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.credentials_font_size | times: 0.85 }}px * {{ settings.body_scale | divided_by: 100.0 }});
    }
  }
{% endstyle %}

<div class="ai-doctor-bio-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-doctor-bio-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.doctor_image %}
      <img
        src="{{ block.settings.doctor_image | image_url: width: 600 }}"
        alt="{{ block.settings.doctor_image.alt | escape }}"
        class="ai-doctor-bio-image-{{ ai_gen_id }}"
        loading="lazy"
        width="{{ block.settings.doctor_image.width }}"
        height="{{ block.settings.doctor_image.height }}"
      >
    {% else %}
      <div class="ai-doctor-bio-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-doctor-bio-content-{{ ai_gen_id }}">
    {% if block.settings.doctor_name != blank %}
      <h2 class="ai-doctor-bio-title-{{ ai_gen_id }}">{{ block.settings.doctor_name }}</h2>
    {% endif %}

    {% if block.settings.doctor_title != blank %}
      <p class="ai-doctor-bio-subtitle-{{ ai_gen_id }}">{{ block.settings.doctor_title }}</p>
    {% endif %}

    {% if block.settings.doctor_description != blank %}
      <div class="ai-doctor-bio-description-{{ ai_gen_id }}">
        {{ block.settings.doctor_description }}
      </div>
    {% endif %}

    {% if block.settings.show_credentials %}
      <div class="ai-doctor-bio-credentials-{{ ai_gen_id }}">
        {% if block.settings.credential_1 != blank %}
          <div class="ai-doctor-bio-credential-{{ ai_gen_id }}">
            <svg class="ai-doctor-bio-credential-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22,4 12,14.01 9,11.01"/>
            </svg>
            {{ block.settings.credential_1 }}
          </div>
        {% endif %}

        {% if block.settings.credential_2 != blank %}
          <div class="ai-doctor-bio-credential-{{ ai_gen_id }}">
            <svg class="ai-doctor-bio-credential-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22,4 12,14.01 9,11.01"/>
            </svg>
            {{ block.settings.credential_2 }}
          </div>
        {% endif %}

        {% if block.settings.credential_3 != blank %}
          <div class="ai-doctor-bio-credential-{{ ai_gen_id }}">
            <svg class="ai-doctor-bio-credential-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22,4 12,14.01 9,11.01"/>
            </svg>
            {{ block.settings.credential_3 }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Doctor biography",
  "settings": [
    {
      "type": "header",
      "content": "Doctor information"
    },
    {
      "type": "image_picker",
      "id": "doctor_image",
      "label": "Doctor photo"
    },
    {
      "type": "text",
      "id": "doctor_name",
      "label": "Doctor name",
      "default": "Dr. John Smith"
    },
    {
      "type": "text",
      "id": "doctor_title",
      "label": "Professional title",
      "default": "Founder & Chief Medical Officer"
    },
    {
      "type": "richtext",
      "id": "doctor_description",
      "label": "Biography",
      "default": "<p>Dr. John Smith is a board-certified physician with over 15 years of experience in preventive medicine and wellness. He founded this practice with a vision to provide personalized, evidence-based healthcare that focuses on treating the whole person, not just symptoms.</p><p>His approach combines traditional medical expertise with innovative treatments to help patients achieve optimal health and vitality.</p>"
    },
    {
      "type": "header",
      "content": "Credentials"
    },
    {
      "type": "checkbox",
      "id": "show_credentials",
      "label": "Show credentials",
      "default": true
    },
    {
      "type": "text",
      "id": "credential_1",
      "label": "Credential 1",
      "default": "MD, Harvard Medical School"
    },
    {
      "type": "text",
      "id": "credential_2",
      "label": "Credential 2",
      "default": "Board Certified in Internal Medicine"
    },
    {
      "type": "text",
      "id": "credential_3",
      "label": "Credential 3",
      "default": "Fellow, American College of Physicians"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "name_font",
      "label": "Doctor name font",
      "options": [
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "name_font_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Doctor name font size",
      "default": 36
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Professional title font",
      "options": [
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Professional title font size",
      "default": 18
    },
    {
      "type": "select",
      "id": "description_font",
      "label": "Biography font",
      "options": [
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Biography font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "credentials_font",
      "label": "Credentials font",
      "options": [
        {
          "value": "heading",
          "label": "Heading font"
        },
        {
          "value": "body",
          "label": "Body font"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "credentials_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Credentials font size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#334fb4"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "image_top",
          "label": "Image on top"
        },
        {
          "value": "content_top",
          "label": "Content on top"
        }
      ],
      "default": "image_top"
    }
  ],
  "presets": [
    {
      "name": "Doctor biography"
    }
  ],
  "tag": null
}
{% endschema %}