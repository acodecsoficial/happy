    "faqs_9gMU6f": {
      "type": "faqs",
      "blocks": {
        "faq_GG6MBM": {
          "type": "faq",
          "settings": {
            "question": "What is the Longevity Shot made of?",
            "answer": "<p>The Longevity Shot is crafted entirely from all-natural ingredients, with 80% of the ingredients being non-GMO. It is gluten-free, vegan, caffeine-free, soy-free, and dairy-free, with no synthetic ingredients, artificial sweeteners, preservatives, or artificial colors/flavors. Each shot contains 18 calories per serving.</p>"
          }
        },
        "faq_4jy9V7": {
          "type": "faq",
          "settings": {
            "question": "Does the Longevity Shot contain sugar or alcohol?",
            "answer": "<p>The Longevity Shot contains 2.5 grams of natural sugar from apple and grape juice concentrate. It is also lightly sweetened with steviol glycosides, a natural sweetener derived from the Stevia rebaudiana plant that is sugar and calorie-free. It is alcohol-free.</p>"
          }
        },
        "faq_JiVH4C": {
          "type": "faq",
          "settings": {
            "question": "Is the Longevity Shot safe for those with allergies or dietary restrictions?",
            "answer": "<p>Yes, the Longevity Shot is free from common allergens like nuts, soy, dairy, and gluten, making it suitable for most women with dietary sensitivities. Additionally, it can fit into most keto diets.</p>"
          }
        },
        "faq_qmLMRa": {
          "type": "faq",
          "settings": {
            "question": "Is the Longevity Shots tested on animals?",
            "answer": "<p>No, the Longevity Shot is not tested on animals.</p>"
          }
        },
        "faq_mqta4H": {
          "type": "faq",
          "settings": {
            "question": "Can I take the Longevity Shot if I’m pregnant or breastfeeding?",
            "answer": "<p>While the Longevity Shot is made with natural ingredients, we always recommend that pregnant or breastfeeding women consult their healthcare provider to ensure it aligns with their unique health needs during this time.</p>"
          }
        },
        "faq_3phNHn": {
          "type": "faq",
          "settings": {
            "question": "How should I take the Longevity Shot, and when is the best time?",
            "answer": "<p>For optimal results, we recommend taking two shots per week, at any time of the day. This schedule helps maintain NAD+ levels and activate sirtuins—proteins vital for cellular health, DNA repair, and metabolic function. This intermittent dosing supports long-term vitality and overall longevity, slowing the aging process without overwhelming your body.</p>"
          }
        },
        "faq_iGM4zV": {
          "type": "faq",
          "settings": {
            "question": "When will I see results from the Longevity Shot?",
            "answer": "<p>The timing of results can vary depending on your body and lifestyle. Many women begin to notice positive changes in energy, skin health, and overall well-being within the first 30 days of regular use.</p>"
          }
        },
        "faq_LXacMF": {
          "type": "faq",
          "settings": {
            "question": "How long should I continue taking the Longevity Shot?",
            "answer": "<p>The long-term benefits of the Longevity Shot—such as cellular health support and slowing the aging process—are best experienced over time with consistent use. </p>"
          }
        },
        "faq_UiMWTG": {
          "type": "faq",
          "settings": {
            "question": "Are there any side effects of interactions with medications?",
            "answer": "<p>The natural ingredients in the Longevity Shot are generally well-tolerated, but everyone is unique. If you’re taking any prescription medications or have a medical condition, particularly autoimmune conditions, we encourage you to consult your healthcare provider before starting the Longevity Shot.</p>"
          }
        },
        "faq_RfTGdA": {
          "type": "faq",
          "settings": {
            "question": "Is the Longevity Shot suitable for children or teenagers?",
            "answer": "<p>The Longevity Shot is formulated with adults in mind. If you’re considering it for children or teenagers, we recommend speaking with a healthcare provider to ensure it’s appropriate for their needs.</p>"
          }
        },
        "faq_nQXECb": {
          "type": "faq",
          "settings": {
            "question": "Is the Longevity Shot Kosher or Halal certified?",
            "answer": "<p>No, the Longevity Shot is not currently Kosher or Halal certified.</p>"
          }
        }
      },
