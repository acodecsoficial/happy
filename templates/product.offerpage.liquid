    "fifty_fifty_Sneidp": {
      "type": "fifty-fifty",
      "blocks": {
        "text_block_aEgn8V": {
          "type": "text_block",
          "settings": {
            "title": "ADVANCED <em>liposomal technology</em>",
            "text": "<p>We believe every nutrient should reach its full potential. That’s why our Longevity Shot uses innovative, patented double Nutri® liposomal technology to maximize bioavailability. Tiny, protective bubbles—called liposomes—encapsulate key nutrients, ensuring they pass safely through your digestive system and are absorbed into your cells.</p><p>Our advanced formula, featuring micron-sized particles and biphasic nutrition, enhances absorption and optimizes nutrient delivery for superior effectiveness.</p>"
          }
        },
        "text_block_gUamQp": {
          "type": "text_block",
          "settings": {
            "title": "YOUR GREATEST <em>cellular advantage</em>",
            "text": "<p>Longevity Shots are powered by Resveratrol and Nicotinamide Riboside (NR)—two of the most researched nutrients for healthy aging. With 220 mg of Resveratrol and 100 mg of NR, our clinically-validated doses provide the best cellular support possible. Paired with your daily healthy choices, these nutrients positively influence your DNA expression and transform how you age.</p>"
          }
        }
      },
      "block_order": [
        "text_block_aEgn8V",
        "text_block_gUamQp"
      ],
      "settings": {
        "image": "shopify://shop_images/happy_aging_0527.png"
      }
    },
    "key_ingredients": {
      "type": "key-ingredients",
      "blocks": {
        "slide_item_JRRBDw": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "Resveratrol",
            "slide_item_eyebrow": "Sourced from: Fermentation-derived yeast",
            "slide_item_text": "Resveratrol is a potent antioxidant that protects your cells from oxidative stress, helping slow down signs of aging. Using advanced fermentation methods, our high-purity resveratrol neutralizes free radicals, supporting firmer, more elastic skin. Resveratrol is also clinically proven to promote cellular repair and reduce inflammation, making it an essential part of your longevity routine."
          }
        },
        "slide_item_YYyUKp": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "Nicotinamide Riboside",
            "slide_item_eyebrow": "Sourced from: Lab-based fermentation process",
            "slide_item_text": "Nicotinamide riboside (NR) is a next-generation form of vitamin B3 that increases your body’s production of NAD+—a key coenzyme for cellular energy and repair that naturally declines with age. By boosting NAD+ levels, NR revitalizes aging cells and optimizes cellular metabolism, helping you feel more energized and your skin look refreshed."
          }
        },
        "slide_item_bnUzna": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "White Currant Extract",
            "slide_item_eyebrow": "Sourced from: European white currants",
            "slide_item_text": "White Currant Extract delivers powerful antioxidant protection, promoting skin firmness and deep detoxification at the cellular level. It shields your skin from oxidative damage and strengthens collagen, leaving it firmer, more elastic, and naturally radiant."
          }
        },
        "slide_item_7xwPAk": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "Ceramides",
            "slide_item_eyebrow": "Sourced from: Rice",
            "slide_item_text": "Ceramides are essential for keeping your skin deeply hydrated and resilient. They are the building blocks of your skin’s moisture barrier, making up 40% of your skin’s outer lipid layer and helping maintain elasticity and prevent moisture loss. By replenishing natural ceramides, this ingredient supports a healthy, plump complexion."
          }
        },
        "slide_item_9UpUVW": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "Blood Orange Extract",
            "slide_item_eyebrow": "Sourced from: Mediterranean orchards",
            "slide_item_text": "Harvested from nutrient-rich Mediterranean soil, our Blood Orange Extract is packed with vitamin C and flavonoids. Vitamin C is vital for collagen production, helping to brighten and firm your skin while protecting against environmental damage. This ingredient leaves your skin glowing and more resilient."
          }
        },
        "slide_item_gh44Cz": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "Spinach Leaf Juice Powder",
            "slide_item_eyebrow": "Sourced from: Organic spinach leaves",
            "slide_item_text": "Brimming with essential vitamins A, C, and K, Spinach Leaf Juice Powder supports your body’s natural detoxification and cellular regeneration. Its antioxidants neutralize free radicals, helping your cells renew and protect against oxidative stress. Combined with Blood Orange Extract, this ingredient boosts cell vitality and skin repair."
          }
        },
        "slide_item_DgWLLk": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "Grape Seed Extract",
            "slide_item_eyebrow": "Sourced from: European grape seeds",
            "slide_item_text": "Carefully sourced from European vineyards, our Grape Seed Extract is packed with polyphenols and flavonoids. This powerful ingredient improves skin elasticity, reduces hyperpigmentation, and promotes a smooth, even complexion. It also supports cardiovascular health and cellular rejuvenation by defending against oxidative damage."
          }
        },
        "slide_item_PdEJed": {
          "type": "slide_item",
          "settings": {
            "slide_item_title": "Alcohol-Free Red Wine Powder",
            "slide_item_eyebrow": "Sourced from: Sangiovese grapes from Tuscany, Italy",
            "slide_item_text": "Derived from Tuscany’s finest Sangiovese grapes, our Alcohol-Free Red Wine Powder is rich in polyphenols and antioxidants. This powerful ingredient offers holistic protection for your skin, enhancing circulation and defending collagen from free radical damage. With regular use, it helps promote a radiant, revitalized complexion."
          }
        }
      },
