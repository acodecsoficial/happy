    "faqs_9gMU6f": {
      "type": "faqs",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "1. How does it support liver health?",
            "answer": "<p>Glutathione is crucial for your liver's Phase II detoxification process. Clinical studies show it helps improve liver function markers and can reduce blood mercury levels by 39% in just 30 days. It helps bind to toxins, heavy metals, and waste products, making them water-soluble so they can be eliminated. A healthy liver means better energy, clearer skin, and more efficient toxin removal.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "2. What does Radiance Tonic do?",
            "answer": "<p>Radiance Tonic supports cellular vitality, liver detoxification, and immune resilience while promoting natural radiance from within. It helps defend against oxidative stress, supports your body's natural detox processes, and enhances overall cellular health. The visible benefits include clearer, more vibrant skin as a reflection of optimal cellular function.</p>"
          }
        },
        "faq_f9UrfV": {
          "type": "faq",
          "settings": {
            "question": "3. How is it different from other Happy Aging tonics?",
            "answer": "<p>Radiance Tonic is focused on cellular longevity and comprehensive wellness, powered by high-potency liposomal glutathione, your body's master antioxidant. Glow Shot is designed for hydration and elasticity with collagen. Calm Shot supports mood and nervous system balance. Each product plays a distinct role in your wellness routine.</p>"
          }
        },
        "faq_dfmbmf": {
          "type": "faq",
          "settings": {
            "question": "4. What makes liposomal glutathione special?",
            "answer": "<p>Liposomal delivery allows glutathione to be absorbed up to 20x more efficiently than powders or capsules. Clinical studies show it can improve liver function and reduce blood mercury levels by 39% in 30 days. That means faster results and better support for your cells where it matters most.</p>"
          }
        },
        "faq_6UkLU3": {
          "type": "faq",
          "settings": {
            "question": "5. How do I take it?",
            "answer": "<p>Take one teaspoon (6 mL) daily, ideally on an empty stomach. You can take it straight or mix it into water, juice, or a smoothie.</p>"
          }
        },
        "faq_LWdF6e": {
          "type": "faq",
          "settings": {
            "question": "6. What does it taste like?",
            "answer": "<p>Radiance Tonic has a clean, tropical fruit flavor with a light tartness. It's sugar-free, naturally flavored, and smooth to sip, no bitterness or aftertaste.</p>"
          }
        },
        "faq_aEfQyb": {
          "type": "faq",
          "settings": {
            "question": "7. How long until I see results?",
            "answer": "<p>Many people notice enhanced energy and mental clarity within the first week. Visible improvements in skin vitality, immune resilience, and overall cellular health typically appear within 30 to 90 days of consistent daily use.</p>"
          }
        },
        "faq_WqnYjM": {
          "type": "faq",
          "settings": {
            "question": "8. Can I take it with Glow Shot, Calm Shot, or Longevity Shot?",
            "answer": "<p>Yes. Radiance Tonic is formulated to complement other Happy Aging products. Each has a unique benefit and can be combined safely in your daily wellness routine.</p>"
          }
        },
        "faq_Eb44T8": {
          "type": "faq",
          "settings": {
            "question": "9. Is it safe for everyday use?",
            "answer": "<p>Yes. Radiance Tonic is formulated with clean, non-GMO ingredients and is third-party tested for safety and quality. It's vegan, sugar-free, and made with pharmaceutical-grade USP water.</p>"
          }
        },
        "faq_YaakAD": {
          "type": "faq",
          "settings": {
            "question": "10. Can I take it if I'm using other supplements or skincare?",
            "answer": "<p>Absolutely. Radiance Tonic is gentle and works from within, making it a great addition to your current supplement or skincare routine. As always, if you have specific health concerns, check with your provider.</p>"
          }
        },
        "faq_3CWMLC": {
          "type": "faq",
          "settings": {
            "question": "11. How does this support graceful aging?",
            "answer": "<p>Radiance Tonic supports your body's natural cellular processes rather than fighting aging. By enhancing cellular vitality, optimizing detoxification, and strengthening immune function, it helps you age with energy, resilience, and natural radiance, embracing the journey with cellular confidence.</p>"
          }
        },
        "faq_d6qTBa": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "12. What happens if I stop taking it?",
            "answer": "<p>Your NAD⁺ levels may gradually decline again, and benefits like energy, focus, or hormonal balance may fade. For long-term support, we recommend using Cell Renew consistently.</p>"
          }
        },
        "faq_ynT9nx": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "13. Are there any side effects?",
            "answer": "<p>Most users experience no side effects. In rare cases, some may feel mild detox-like symptoms in the first few days such as slight headache or fatigue as NAD⁺ pathways reactivate. These typically resolve quickly.</p>"
          }
        },
        "faq_y8B9H8": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "14. What’s in it?",
            "answer": "<p>Ingredients per 6 ml serving:<br/> NMN (Nicotinamide Mononucleotide) 444 mg<br/> Purified water<br/> Vegetable glycerin<br/> Non-GMO sunflower lecithin<br/> Natural citrus flavor<br/> Potassium sorbate<br/> Stevia<br/> Free from sugar, caffeine, gluten, dairy, soy, synthetic additives, and GMOs</p>"
          }
        },
        "faq_mjT3ae": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "15. Is it vegan and non-GMO?",
            "answer": "<p>Yes. Cell Renew is 100 percent vegan and non-GMO. It is made with clean-label ingredients and third-party tested for purity and potency.</p>"
          }
        },
        "faq_dQMyfY": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "16. Is the product FDA-approved?",
            "answer": "<p>As with all dietary supplements in the United States, Cell Renew is not evaluated by the FDA. However, it is manufactured in certified facilities that follow GMP guidelines, and the ingredients are backed by clinical research.</p>"
          }
        },
        "faq_hgWKNQ": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "17. What’s your return policy?",
            "answer": "<p>We offer a 30-day money-back guarantee. If you are not satisfied with your results, contact our support team. Your first order also includes free shipping.</p>"
          }
        },
        "faq_hATLcE": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "18. How should I store the bottle?",
            "answer": "<p>Store it in a cool, dry place away from sunlight. Refrigeration after opening is optional and can help preserve freshness.</p>"
          }
        },
        "faq_LAfBXQ": {
          "type": "faq",
          "disabled": true,
          "settings": {
            "question": "19. How long should I take Cell Renew?",
            "answer": "<p>Cell Renew is designed for long-term use. The benefits are cumulative. We recommend using it for at least 60 to 90 days to allow your NAD⁺ levels to stabilize and your results to build over time.</p>"
          }
        }
      },
