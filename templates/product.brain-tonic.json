    "faqs_9gMU6f": {
      "type": "faqs",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "1. What is Brain Tonic?",
            "answer": "<p>Brain Tonic is a clean, citrus-flavored liquid shot formulated with 105.6 mg of highly bioavailable CoQ10. It supports cognitive clarity, cellular energy production, and long-term brain health helping you feel sharp, focused, and vibrant at every age.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "2. How do I use Brain Tonic?",
            "answer": "<p>Enjoy one bottle in the morning or before mentally demanding tasks. Shake well before drinking. It’s ideal for starting your day, boosting focus at work, or staying mentally resilient while traveling.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "3. Is Brain Tonic caffeinated?",
