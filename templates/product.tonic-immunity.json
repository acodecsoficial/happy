          "type": "faq",
          "settings": {
            "question": "13. Are there any side effects?",
            "answer": "<p>Most users experience no side effects. In rare cases, some may feel mild detox-like symptoms in the first few days such as slight headache or fatigue as NAD⁺ pathways reactivate. These typically resolve quickly.</p>"
          }
        },
        "faq_y8B9H8": {
          "type": "faq",
          "settings": {
            "question": "14. What’s in it?",
            "answer": "<p>Ingredients per 6 ml serving:<br/> NMN (Nicotinamide Mononucleotide) 444 mg<br/> Purified water<br/> Vegetable glycerin<br/> Non-GMO sunflower lecithin<br/> Natural citrus flavor<br/> Potassium sorbate<br/> Stevia<br/> Free from sugar, caffeine, gluten, dairy, soy, synthetic additives, and GMOs</p>"
          }
        },
        "faq_mjT3ae": {
          "type": "faq",
          "settings": {
            "question": "15. Is it vegan and non-GMO?",
            "answer": "<p>Yes. Cell Renew is 100 percent vegan and non-GMO. It is made with clean-label ingredients and third-party tested for purity and potency.</p>"
          }
        },
        "faq_dQMyfY": {
          "type": "faq",
          "settings": {
            "question": "16. Is the product FDA-approved?",
