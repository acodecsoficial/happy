    "faqs_9gMU6f": {
      "type": "faqs",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "1. What exactly is Cell Renew Tonic?",
            "answer": "<p>Cell Renew Tonic is a red berry liquid NMN supplement designed to help women feel sharper, stronger, and more energized at any age. It works at the cellular level to boost NAD⁺, your body’s natural fuel for energy, repair, and resilience. Just one teaspoon a day helps reset your energy, balance your hormones, and support graceful, empowered aging.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "2. Who is this product for?",
            "answer": "<p>This formula is made for women over 35 who want more energy, better focus, and smoother hormone balance without caffeine, sugar, or unnecessary pills. Whether you're juggling career, family, workouts, or perimenopause, this is your foundational wellness ritual.<br/><br/></p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "3. Why is NAD⁺ important for my body?",
            "answer": "<p>NAD⁺ is a molecule found in every cell. It powers essential functions like energy production, DNA repair, hormone regulation, and mental clarity. As we age, NAD⁺ levels can drop by up to 50 percent by age 40. Cell Renew helps restore those levels using NMN, a direct NAD⁺ precursor.<br/><br/></p>"
          }
        },
        "faq_dfmbmf": {
          "type": "faq",
          "settings": {
            "question": "4. What makes Cell Renew Tonic different from capsules or powders?",
            "answer": "<p>It delivers up to 10 times better absorption with advanced liposomal delivery</p><p>It comes in liquid form for faster action and no digestive discomfort</p><p>Each teaspoon contains 444 mg of NMN in a clinically aligned dose </p><p>It is designed specifically for women’s metabolism and hormone rhythms </p><p>It uses a clean label formula that is vegan, non-GMO, sugar-free, caffeine-free, and gut-friendly </p><p>It is backed by scientific studies and third-party tested<br/><br/></p>"
          }
        },
        "faq_6UkLU3": {
          "type": "faq",
          "settings": {
            "question": "5. When will I start noticing results?",
            "answer": "<p>Week 1: Brighter mornings, less mental fog<br/> By Day 30: More sustained energy, emotional stability, and improved focus<br/> By Day 60: Increased stamina, faster recovery, and better hormone balance<br/> After 90 Days: Greater resilience, deeper cellular vitality, and lasting mental clarity<br/> Results may vary depending on your baseline NAD⁺ levels, lifestyle, and consistency.</p>"
