    "faqs_9gMU6f": {
      "type": "faqs",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "1. What exactly is Calm Tonic?",
            "answer": "<p>A fast-working magnesium shot that helps you focus, stay composed, and think more clearly when life gets busy.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "2. Who is it for?",
            "answer": "<p>Anyone dealing with stress, intense focus demands, or hormonal mood swings from professionals to creatives to caregivers.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "3. What type of magnesium is used?",
            "answer": "<p>We use magnesium bisglycinate, known for its high bioavailability and gentleness on digestion no laxative effect.<br/></p>"
          }
        },
        "faq_dfmbmf": {
          "type": "faq",
          "settings": {
